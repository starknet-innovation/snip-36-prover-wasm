+#[cfg(all(test, feature = "prover"))]
+mod sourced_preprocessing_tests {
+    use super::*;
+    use stwo::prover::TraceSource;
+    use stwo::prover::backend::simd::SimdBackend;
+    #[test]
+    fn sources_match_original_generated_columns_in_commitment_order() {
+        let mut context = circuits::context::Context::<stwo::core::fields::qm31::QM31>::default().finalize(false);
+        let preprocessed = PreprocessedCircuit::preprocess_circuit(&mut context);
+        let expected = preprocessed.preprocessed_trace.get_trace::<SimdBackend>();
+        for (source, expected) in PreprocessedColumnSource::all(&preprocessed.preprocessed_trace).iter().zip(expected) {
+            let mut values = vec![BaseField::default(); 1 << source.log_size()];
+            source.write_values(&mut values);
+            assert_eq!(values, expected.values.to_cpu());
+        }
+    }
+}
