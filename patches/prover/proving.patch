@@ -0,0 +1,59 @@
+use std::sync::Arc;
+use cairo_vm::vm::runners::cairo_pie::CairoPie;
+use privacy_prove::{prepare_recursive_prover_precomputes, privacy_recursive_prove, RecursiveProverPrecomputes};
+use wasm_bindgen::prelude::*;
+
+#[wasm_bindgen(inline_js = "export function reportStage(json) { self.postMessage({kind:'stage', ...JSON.parse(json)}); }")]
+extern "C" { #[wasm_bindgen(js_name = reportStage)] fn report_stage(json: &str); }
+fn stage(message: &str) {
+    report_stage(&format!("{{\"message\":{},\"metrics\":{}}}", serde_json::to_string(message).unwrap(), crate::alloc_metrics::snapshot()));
+}
+
+
+
+#[wasm_bindgen]
+pub struct BrowserProver {
+    precomputes: Arc<RecursiveProverPrecomputes>,
+}
+
+#[wasm_bindgen]
+pub struct BrowserProof {
+    proof: Vec<u8>,
+    output_preimage: String,
+}
+
+#[wasm_bindgen]
+impl BrowserProof {
+    pub fn proof_bytes(&self) -> Vec<u8> { self.proof.clone() }
+    pub fn output_preimage_json(&self) -> String { self.output_preimage.clone() }
+}
+
+#[wasm_bindgen]
+impl BrowserProver {
+    #[wasm_bindgen(constructor)]
+    pub fn new() -> Result<BrowserProver, JsValue> {
+        console_error_panic_hook::set_once();
+        crate::progress::install(stage);
+        let precomputes = prepare_recursive_prover_precomputes()
+            .map_err(|e| JsValue::from_str(&e.to_string()))?;
+        Ok(Self { precomputes })
+    }
+
+    pub fn prove(&self, pie_bytes: &[u8]) -> Result<BrowserProof, JsValue> {
+        let pie = CairoPie::from_bytes(pie_bytes)
+            .map_err(|e| JsValue::from_str(&e.to_string()))?;
+        let result = privacy_recursive_prove(pie, self.precomputes.clone())
+            .map_err(|e| JsValue::from_str(&e.to_string()))?;
+        let felts: Vec<String> = result.output_preimage.iter().map(|f| format!("{f:#x}")).collect();
+        Ok(BrowserProof {
+            proof: result.proof,
+            output_preimage: serde_json::to_string(&felts).map_err(|e| JsValue::from_str(&e.to_string()))?,
+        })
+    }
+}
+
+#[wasm_bindgen]
+pub fn linear_memory() -> JsValue { wasm_bindgen::memory() }
+
+#[wasm_bindgen]
+pub fn allocation_metrics() -> String { crate::alloc_metrics::snapshot() }
