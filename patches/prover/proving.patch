@@ -0,0 +1,33 @@
+//! Export only the prover's high-level informational stage messages.
+use tracing::{Event, Metadata, Subscriber, span::{Attributes, Id, Record}};
+
+struct StageSubscriber { report: fn(&str) }
+struct Message(String);
+impl tracing::field::Visit for Message {
+    fn record_debug(&mut self, field: &tracing::field::Field, value: &dyn std::fmt::Debug) {
+        if field.name() == "message" { self.0 = format!("{value:?}"); }
+    }
+}
+impl Subscriber for StageSubscriber {
+    fn enabled(&self, metadata: &Metadata<'_>) -> bool {
+        metadata.target() == "privacy_prove" && *metadata.level() <= tracing::Level::INFO
+    }
+    fn new_span(&self, _: &Attributes<'_>) -> Id { Id::from_u64(1) }
+    fn record(&self, _: &Id, _: &Record<'_>) {}
+    fn record_follows_from(&self, _: &Id, _: &Id) {}
+    fn event(&self, event: &Event<'_>) {
+        if !self.enabled(event.metadata()) { return; }
+        let mut message = Message(String::new());
+        event.record(&mut message);
+        if !message.0.is_empty() { (self.report)(&message.0); }
+    }
+    fn enter(&self, _: &Id) {}
+    fn exit(&self, _: &Id) {}
+    fn max_level_hint(&self) -> Option<tracing::level_filters::LevelFilter> {
+        Some(tracing::level_filters::LevelFilter::INFO)
+    }
+}
+
+pub fn install(report: fn(&str)) {
+    let _ = tracing::subscriber::set_global_default(StageSubscriber { report });
+}
