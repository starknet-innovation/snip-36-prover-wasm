@@ -0,0 +1,99 @@
+//! Small explicit memory64 ABI: JS receives i64 pointers as BigInt and makes bounded views.
+use std::{cell::RefCell, sync::Arc};
+use cairo_vm::vm::runners::cairo_pie::CairoPie;
+use privacy_prove::{prepare_recursive_prover_precomputes, privacy_recursive_prove, RecursiveProverPrecomputes};
+
+#[link(wasm_import_module = "browser")]
+unsafe extern "C" {
+    fn random_fill(ptr: *mut u8, len: usize) -> i32;
+    fn report_progress(ptr: *const u8, len: usize);
+    fn report_panic(ptr: *const u8, len: usize);
+}
+
+fn fill_random(buf: &mut [u8]) -> Result<(), getrandom_v2::Error> {
+    // SAFETY: JS synchronously fills exactly this live, writable slice using Web Crypto.
+    if unsafe { random_fill(buf.as_mut_ptr(), buf.len()) } == 0 { Ok(()) }
+    else { Err(getrandom_v2::Error::UNSUPPORTED) }
+}
+getrandom_v2::register_custom_getrandom!(fill_random);
+
+// Use separate symbols per getrandom version to retain each version's exact Rust ABI.
+#[unsafe(no_mangle)]
+unsafe fn __getrandom_v03_custom(ptr: *mut u8, len: usize) -> Result<(), getrandom_v3::Error> {
+    if unsafe { random_fill(ptr, len) } == 0 { Ok(()) }
+    else { Err(getrandom_v3::Error::UNSUPPORTED) }
+}
+
+#[unsafe(no_mangle)]
+unsafe fn __getrandom_v04_custom(ptr: *mut u8, len: usize) -> Result<(), getrandom_v4::Error> {
+    if unsafe { random_fill(ptr, len) } == 0 { Ok(()) }
+    else { Err(getrandom_v4::Error::UNSUPPORTED) }
+}
+
+thread_local! {
+    static PRE: RefCell<Option<Arc<RecursiveProverPrecomputes>>> = const { RefCell::new(None) };
+    static PROOF: RefCell<Vec<u8>> = const { RefCell::new(Vec::new()) };
+    static OUTPUT: RefCell<Vec<u8>> = const { RefCell::new(Vec::new()) };
+    static ERROR: RefCell<Vec<u8>> = const { RefCell::new(Vec::new()) };
+    static METRICS: RefCell<Vec<u8>> = const { RefCell::new(Vec::new()) };
+}
+
+fn status(result: Result<(), String>) -> i32 {
+    match result {
+        Ok(()) => { ERROR.with(|x| x.borrow_mut().clear()); 0 }
+        Err(e) => { ERROR.with(|x| *x.borrow_mut() = e.into_bytes()); 1 }
+    }
+}
+
+fn stage(message: &str) {
+    let json = format!("{{\"message\":{},\"metrics\":{}}}", serde_json::to_string(message).unwrap(), crate::alloc_metrics::snapshot());
+    // SAFETY: JS synchronously copies this live UTF-8 slice before returning.
+    unsafe { report_progress(json.as_ptr(), json.len()) };
+}
+
+#[unsafe(no_mangle)]
+pub extern "C" fn spike_init() -> i32 {
+    crate::progress::install(stage);
+    std::panic::set_hook(Box::new(|info| {
+        let text = info.to_string();
+        unsafe { report_panic(text.as_ptr(), text.len()) };
+    }));
+    status(prepare_recursive_prover_precomputes().map(|pre| PRE.with(|x| *x.borrow_mut() = Some(pre))).map_err(|e| e.to_string()))
+}
+
+/// Caller must pass a live allocation of `len` bytes from spike_alloc.
+#[unsafe(no_mangle)]
+pub unsafe extern "C" fn spike_prove(ptr: *const u8, len: usize) -> i32 {
+    status((|| {
+        let bytes = unsafe { std::slice::from_raw_parts(ptr, len) };
+        let pie = CairoPie::from_bytes(bytes).map_err(|e| e.to_string())?;
+        let pre = PRE.with(|x| x.borrow().clone()).ok_or("prover not initialized")?;
+        let result = privacy_recursive_prove(pie, pre).map_err(|e| e.to_string())?;
+        let felts: Vec<String> = result.output_preimage.iter().map(|f| format!("{f:#x}")).collect();
+        let output = serde_json::to_vec(&felts).map_err(|e| e.to_string())?;
+        PROOF.with(|x| *x.borrow_mut() = result.proof);
+        OUTPUT.with(|x| *x.borrow_mut() = output);
+        Ok(())
+    })())
+}
+
+#[unsafe(no_mangle)]
+pub extern "C" fn spike_alloc(len: usize) -> *mut u8 { Box::into_raw(vec![0u8; len].into_boxed_slice()) as *mut u8 }
+#[unsafe(no_mangle)]
+pub unsafe extern "C" fn spike_dealloc(ptr: *mut u8, len: usize) {
+    unsafe { drop(Box::from_raw(std::ptr::slice_from_raw_parts_mut(ptr, len))) };
+}
+
+macro_rules! accessor {
+    ($ptr:ident, $len:ident, $storage:ident) => {
+        #[unsafe(no_mangle)] pub extern "C" fn $ptr() -> *const u8 { $storage.with(|x| x.borrow().as_ptr()) }
+        #[unsafe(no_mangle)] pub extern "C" fn $len() -> usize { $storage.with(|x| x.borrow().len()) }
+    };
+}
+accessor!(spike_proof_ptr, spike_proof_len, PROOF);
+accessor!(spike_output_ptr, spike_output_len, OUTPUT);
+accessor!(spike_error_ptr, spike_error_len, ERROR);
+accessor!(spike_metrics_ptr, spike_metrics_len, METRICS);
+
+#[unsafe(no_mangle)]
+pub extern "C" fn spike_measure() { METRICS.with(|x| *x.borrow_mut() = crate::alloc_metrics::snapshot().into_bytes()); }
