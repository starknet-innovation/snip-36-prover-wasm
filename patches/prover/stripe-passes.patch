+/// The layers of [`MerkleOpsLifted::build_layers_sparse`] from the leaves: the leaves and the
+/// [`OMITTED_LAYERS`] - 1 layers above them are each dropped once the next one is built.
+fn sparse_layers<const IS_M31_OUTPUT: bool>(
+    leaves: Vec<Blake2sHash>,
+    lifting_log_size: u32,
+) -> Vec<Vec<Blake2sHash>> {
+    type Ops<const M: bool> = Blake2sMerkleHasherGeneric<M>;
+    let mut layer = leaves;
+    for _ in 0..OMITTED_LAYERS {
+        layer = <SimdBackend as MerkleOpsLifted<Ops<IS_M31_OUTPUT>>>::build_next_layer(&layer);
+    }
+    let mut layers: Vec<Vec<Blake2sHash>> = (0..OMITTED_LAYERS).map(|_| Vec::new()).collect();
+    layers.push(layer);
+    for _ in OMITTED_LAYERS..lifting_log_size {
+        layers.push(<SimdBackend as MerkleOpsLifted<Ops<IS_M31_OUTPUT>>>::build_next_layer(layers.last().unwrap()));
+    }
+    layers
+}
