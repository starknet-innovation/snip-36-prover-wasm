+    #[test]
+    fn test_striped_packed_layers_match_whole_build() {
+        // Below, at and above one stripe of 2^14 leaves; both hasher outputs.
+        fn check<const M: bool>(lifting_log_size: u32) {
+            let len = 4usize << lifting_log_size;
+            let cols: [BaseColumn; 4] = std::array::from_fn(|c| {
+                (0..len).map(|i| M31::from_u32_unchecked((i as u32).wrapping_mul(2654435761).wrapping_add(c as u32 * 97) % 2147483647)).collect()
+            });
+            let refs = cols.each_ref();
+            let packed = <SimdBackend as PackLeavesOps>::pack_leaves_input(&refs);
+            let whole = <SimdBackend as MerkleOpsLifted<Blake2sMerkleHasherGeneric<M>>>::build_layers(&packed.iter().collect_vec(), lifting_log_size);
+            let striped = <SimdBackend as MerkleOpsLifted<Blake2sMerkleHasherGeneric<M>>>::build_packed_layers(&refs, lifting_log_size);
+            assert_eq!(striped.len(), whole.len());
+            for (s, w) in striped.iter().zip(&whole) {
+                assert!(s.is_empty() || s == w);
+            }
+            assert!(striped[5..].iter().zip(&whole[5..]).all(|(s, w)| s == w));
+            let fri = MerkleProverLifted::<SimdBackend, Blake2sMerkleHasherGeneric<M>>::commit(refs.to_vec(), lifting_log_size, 2);
+            assert_eq!(fri.root(), *whole.last().unwrap().first().unwrap());
+        }
+        for log in [12, 14, 15, 16] {
+            check::<false>(log);
+            check::<true>(log);
+        }
+    }
