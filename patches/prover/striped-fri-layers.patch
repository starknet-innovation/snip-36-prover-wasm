+    /// [`MerkleOpsLifted::build_layers_sparse`] of the packed leaves, built a stripe of
+    /// `2^LOG_STRIPE_LEAVES` leaves at a time: each stripe's rows are packed and hashed up to
+    /// layer [`OMITTED_LAYERS`], so neither the packed copy of the columns nor the leaves are
+    /// ever whole. A leaf hashes only its own rows and the stripes are aligned subtrees, so the
+    /// layers are the ones the whole-column build produces.
+    fn build_packed_layers(
+        columns: &[&Col<Self, BaseField>; SECURE_EXTENSION_DEGREE],
+        lifting_log_size: u32,
+    ) -> Vec<Col<Self, Blake2sHash>> {
+        const LOG_STRIPE_LEAVES: u32 = 14;
+        type Ops<const M: bool> = Blake2sMerkleHasherGeneric<M>;
+        if lifting_log_size < LOG_STRIPE_LEAVES {
+            let packed = <Self as PackLeavesOps>::pack_leaves_input(columns);
+            return <Self as MerkleOpsLifted<Ops<IS_M31_OUTPUT>>>::build_layers_sparse(&packed.iter().collect_vec(), lifting_log_size);
+        }
+        assert!(columns.iter().all(|c| c.len() == PACKED_LEAF_SIZE << lifting_log_size));
+        let stripe_packed_len = (PACKED_LEAF_SIZE << LOG_STRIPE_LEAVES) / N_LANES;
+        let mut kept = Vec::with_capacity(1 << (lifting_log_size - OMITTED_LAYERS));
+        for stripe in 0..1 << (lifting_log_size - LOG_STRIPE_LEAVES) {
+            let rows = stripe * stripe_packed_len..(stripe + 1) * stripe_packed_len;
+            let parts: [BaseColumn; SECURE_EXTENSION_DEGREE] = array::from_fn(|coord| BaseColumn {
+                data: columns[coord].data[rows.clone()].to_vec(),
+                length: PACKED_LEAF_SIZE << LOG_STRIPE_LEAVES,
+            });
+            let packed = <Self as PackLeavesOps>::pack_leaves_input(&parts.each_ref());
+            drop(parts);
+            let mut layer = <Self as MerkleOpsLifted<Ops<IS_M31_OUTPUT>>>::build_leaves(&packed.iter().collect_vec(), LOG_STRIPE_LEAVES);
+            drop(packed);
+            for _ in 0..OMITTED_LAYERS {
+                layer = <Self as MerkleOpsLifted<Ops<IS_M31_OUTPUT>>>::build_next_layer(&layer);
+            }
+            kept.extend(layer);
+        }
+        let mut layers: Vec<Vec<Blake2sHash>> = (0..OMITTED_LAYERS).map(|_| Vec::new()).collect();
+        layers.push(kept);
+        for _ in OMITTED_LAYERS..lifting_log_size {
+            layers.push(<Self as MerkleOpsLifted<Ops<IS_M31_OUTPUT>>>::build_next_layer(layers.last().unwrap()));
+        }
+        layers
+    }
