+fn fft_subdomains_into(
+    poly: &CircleCoefficients<SimdBackend>,
+    dst: &mut BaseColumn,
+    subdomain_twiddles: &[Vec<&[u32]>],
+) {
+    let n = poly.log_size();
+    assert!(n >= MIN_FFT_LOG_SIZE);
