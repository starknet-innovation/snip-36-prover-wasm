+    #[test]
+    fn transposed_coefficients_and_block_outputs_match_cpu() {
+        for log_size in [17, 18] {
+            let domain = CanonicCoset::new(log_size + 1).circle_domain();
+            let cpu_twiddles = CpuBackend::precompute_twiddles(domain.half_coset);
+            let twiddles = SimdBackend::precompute_twiddles(domain.half_coset);
+            let coefficients = CircleCoefficients::<CpuBackend>::new((0..1 << log_size).map(|row| BaseField::from((row * 17 + 1) % 8191)).collect());
+            let trace = coefficients.evaluate_with_twiddles(CanonicCoset::new(log_size).circle_domain(), &cpu_twiddles);
+            let poly = SimdBackend::interpolate(CircleEvaluation::new(trace.domain, trace.values.into_iter().collect()), &twiddles);
+            let expected = coefficients.evaluate_with_twiddles(domain, &cpu_twiddles).values;
+            // log-18 -> log-17 also exercises the folded output's transposition before FFT.
+            for log_block in [log_size - 1, log_size] {
+                let len = 1 << log_block;
+                let mut actual = BaseColumn::zeros(len);
+                for block in 0..(1 << (domain.log_size() - log_block)) {
+                    evaluate_block_into(&poly, domain, &twiddles, log_block, block, &mut actual);
+                    assert_eq!(actual.to_cpu(), expected[block * len..(block + 1) * len], "log_size={log_size}, log_block={log_block}, block={block}");
+                }
+            }
+        }
+    }
+}
