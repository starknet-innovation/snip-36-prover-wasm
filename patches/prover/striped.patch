+    let total = subdomain_twiddles.len().checked_mul(len).expect("FFT destination size overflow");
+    assert_eq!(poly.coeffs.len(), len);
+    assert!(poly.coeffs.data.len().checked_mul(N_LANES).unwrap() >= len);
+    assert!(dst.len() >= total);
+    assert!(dst.data.len().checked_mul(N_LANES).unwrap() >= total);
