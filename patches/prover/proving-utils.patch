diff --git a/vendor/zstd-sys-2.0.16+zstd.1.5.7/zstd/lib/deprecated/zbuff_compress.c b/vendor/zstd-sys-2.0.16+zstd.1.5.7/zstd/lib/deprecated/zbuff_compress.c
