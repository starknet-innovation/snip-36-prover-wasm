+pub const fn round(acc: u32, input: u32) -> u32 {
+    acc.wrapping_add(input.wrapping_mul(PRIME_2))
+       .rotate_left(13)
+       .wrapping_mul(PRIME_1)
+}
+
+#[inline]
+pub const fn avalanche(mut input: u32) -> u32 {
+    input ^= input >> 15;
+    input = input.wrapping_mul(PRIME_2);
