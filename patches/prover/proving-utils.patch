+//For some dumb reasons vld1q_u8 is unstable for arm
+#[cfg(all(target_arch = "arm", target_feature = "neon"))]
+macro_rules! vld1q_u8 {
+    ($ptr:expr) => {
+        core::ptr::read_unaligned($ptr as *const core::arch::arm::uint8x16_t)
+    }
+}
