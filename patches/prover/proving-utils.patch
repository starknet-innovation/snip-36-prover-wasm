+macro_rules! to_u128 {
+    ($lo:expr, $hi:expr) => {
+        ($lo) as u128 | ((($hi) as u128) << 64)
+    };
+}
+
+macro_rules! slice_offset_ptr {
+    ($slice:expr, $offset:expr) => {{
+        let slice = $slice;
+        let offset = $offset;
+        debug_assert!(slice.len() >= offset);
+
+        #[allow(unused_unsafe)]
+        unsafe {
+            (slice.as_ptr() as *const u8).add(offset)
+        }
+    }}
+}
