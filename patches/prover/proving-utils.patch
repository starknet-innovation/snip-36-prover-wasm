--- /dev/null
+++ b/vendor/zstd-sys-2.0.16+zstd.1.5.7/zstd/lib/dictBuilder/cover.c
@@ -0,0 +1,1302 @@
+/*
+ * Copyright (c) Meta Platforms, Inc. and affiliates.
+ * All rights reserved.
+ *
