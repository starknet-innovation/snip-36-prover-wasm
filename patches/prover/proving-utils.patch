+    match seed {
+        0 => xxh3_128_long_impl(input, &DEFAULT_SECRET),
+        seed => xxh3_128_long_impl(input, &custom_default_secret(seed)),
+    }
+}
+
+#[inline(never)]
+fn xxh3_128_long_with_secret(input: &[u8], _seed: u64, secret: &[u8]) -> u128 {
+    xxh3_128_long_impl(input, secret)
+}
