+/// Lossless compact storage. Gate columns are built here directly, rather than
+/// allocating a full `Vec<usize>` before narrowing it.
+#[derive(Clone, Debug, PartialEq, Eq)]
+enum CompactColumn {
+    Bits { len: usize, words: Vec<u64> },
+    Narrow(Vec<u32>),
+    Wide(Vec<usize>),
+    Fixed { log_size: u32, kind: FixedKind },
+}
+
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+enum FixedKind { Seq, XorRhs(u32), XorLhs(u32), XorResult(u32) }
+
+impl Default for CompactColumn {
+    fn default() -> Self { Self::Bits { len: 0, words: Vec::new() } }
+}
+
+impl CompactColumn {
+    fn len(&self) -> usize {
+        match self {
+            Self::Bits { len, .. } => *len,
+            Self::Narrow(values) => values.len(),
+            Self::Wide(values) => values.len(),
+            Self::Fixed { log_size, .. } => 1_usize << log_size,
+        }
+    }
+    fn at(&self, row: usize) -> usize {
+        assert!(row < self.len());
+        match self {
+            Self::Bits { words, .. } => ((words[row / 64] >> (row % 64)) & 1) as usize,
+            Self::Narrow(values) => values[row] as usize,
+            Self::Wide(values) => values[row],
+            Self::Fixed { kind, .. } => match kind {
+                FixedKind::Seq => row,
+                FixedKind::XorRhs(n) => row >> n,
+                FixedKind::XorLhs(n) => row & ((1_usize << n) - 1),
+                FixedKind::XorResult(n) => (row >> n) ^ (row & ((1_usize << n) - 1)),
+            },
+        }
+    }
+    fn iter(&self) -> impl ExactSizeIterator<Item = usize> + '_ {
+        (0..self.len()).map(|row| self.at(row))
+    }
+    fn push(&mut self, value: usize) {
+        if matches!(self, Self::Bits { .. }) && value > 1 {
+            // The existing prefix consists only of literal booleans.
+            *self = Self::Narrow(self.iter().map(|v| u32::try_from(v).unwrap()).collect());
+        }
+        if matches!(self, Self::Narrow(_)) && u32::try_from(value).is_err() {
+            *self = Self::Wide(self.iter().collect());
+        }
+        match self {
+            Self::Bits { len, words } => {
+                if *len % 64 == 0 { words.push(0); }
+                words[*len / 64] |= (value as u64) << (*len % 64);
+                *len += 1;
+            }
+            Self::Narrow(values) => values.push(u32::try_from(value).unwrap()),
+            Self::Wide(values) => values.push(value),
+            Self::Fixed { .. } => panic!("Cannot append to formula-generated column"),
+        }
+    }
+    fn as_wide(&self) -> std::borrow::Cow<'_, [usize]> {
+        match self {
+            Self::Wide(values) => std::borrow::Cow::Borrowed(values),
+            _ => std::borrow::Cow::Owned(self.iter().collect()),
+        }
+    }
+}
+impl Extend<usize> for CompactColumn {
+    fn extend<I: IntoIterator<Item = usize>>(&mut self, values: I) {
+        for value in values { self.push(value); }
+    }
+}
+
+#[cfg(test)]
+mod compact_tests {
+    use super::*;
+    #[test]
+    fn widths_and_boolean_word_boundaries_are_lossless() {
+        for len in [0, 1, 63, 64, 65, 127, 128, 129] {
+            let expected: Vec<_> = (0..len).map(|row| row % 2).collect();
+            let mut column = CompactColumn::default(); column.extend(expected.iter().copied());
+            assert_eq!(column.iter().collect::<Vec<_>>(), expected);
+            assert!(matches!(column, CompactColumn::Bits { .. }));
+            column.push(u32::MAX as usize);
+            assert!(matches!(column, CompactColumn::Narrow(_)));
+            assert_eq!(column.at(len), u32::MAX as usize);
+            #[cfg(target_pointer_width = "64")]
+            {
+                column.push(u32::MAX as usize + 1);
+                assert!(matches!(column, CompactColumn::Wide(_)));
+                assert_eq!(column.at(len + 1), u32::MAX as usize + 1);
+                assert_eq!(column.iter().take(len).collect::<Vec<_>>(), expected);
+            }
+        }
+    }
+    #[test]
+    fn generated_lookup_values_preserve_original_order_and_lengths() {
+        for n in [4, 7, 8, 9, 10] {
+            let original = gen_xor_columns(n as usize);
+            for (i, kind) in [FixedKind::XorRhs(n), FixedKind::XorLhs(n), FixedKind::XorResult(n)].into_iter().enumerate() {
+                let generated = CompactColumn::Fixed { log_size: 2 * n, kind };
+                assert_eq!(generated.iter().collect::<Vec<_>>(), original[i]);
+            }
+        }
+        let seq = CompactColumn::Fixed { log_size: 16, kind: FixedKind::Seq };
+        assert_eq!(seq.iter().collect::<Vec<_>>(), (0..1 << 16).collect::<Vec<_>>());
+    }
+}
