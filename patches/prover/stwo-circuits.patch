+#[test]
+fn test_owned_values_are_isolated_across_sequential_calls_and_errors() {
+    use crate::prover::{prove_circuit_with_owned_values, prove_circuit_with_precompute};
+    use stwo::core::poly::circle::CanonicCoset;
+    use stwo::core::utils::MaybeOwned;
+    use stwo::prover::CommitmentTreeProver;
+    use stwo::prover::poly::circle::PolyOps;
+    let mut context = build_fibonacci_context().finalize(false);
+    let preprocessed = PreprocessedCircuit::preprocess_circuit(&mut context);
+    let values = context.into_values();
+    let default_config = PcsConfig::default();
+    let log_size = preprocessed.trace_log_size + default_config.fri_config.log_blowup_factor;
+    let config = PcsConfig { lifting_log_size: Some(log_size), ..default_config };
+    let twiddles = SimdBackend::precompute_twiddles(CanonicCoset::new(log_size).circle_domain().half_coset);
+    let pool = BaseColumnPool::<SimdBackend>::new();
+    let coefficients = SimdBackend::interpolate_columns(preprocessed.preprocessed_trace.get_trace::<SimdBackend>(), &twiddles);
+    let tree = CommitmentTreeProver::<SimdBackend, Blake2sM31MerkleChannel>::new(
+        coefficients, config.fri_config.log_blowup_factor, &twiddles, true, config.lifting_log_size, &pool);
+    let borrowed = prove_circuit_with_precompute(&pool, &twiddles, &preprocessed, MaybeOwned::Borrowed(&tree), &values, config).unwrap();
+    let roots = borrowed.stark_proof.proof.commitments.clone();
+    stwo_verify(borrowed, &preprocessed);
+    for _ in 0..2 {
+        let failed = std::panic::catch_unwind(std::panic::AssertUnwindSafe(|| {
+            prove_circuit_with_owned_values(&pool, &twiddles, &preprocessed, MaybeOwned::Borrowed(&tree), Vec::new(), config)
+        }));
+        assert!(failed.is_err());
+        let owned = prove_circuit_with_owned_values(&pool, &twiddles, &preprocessed, MaybeOwned::Borrowed(&tree), values.clone(), config).unwrap();
+        assert_eq!(owned.stark_proof.proof.commitments.0, roots.0);
+        stwo_verify(owned, &preprocessed);
+    }
+}
