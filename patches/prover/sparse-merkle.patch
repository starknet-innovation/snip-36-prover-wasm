+    /// Keeps only the layers from [`OMITTED_LAYERS`] up: the leaves and the lowest inner layers
+    /// are each dropped once the next layer is built, so at most two of them are resident.
+    /// `MerkleProverLifted::decommit_from` recomputes the few hashes of those layers it reads.
+    fn build_layers_sparse(
+        columns: &[&Col<Self, BaseField>],
+        lifting_log_size: u32,
+    ) -> Vec<Col<Self, Blake2sHash>> {
+        if columns.is_empty() || lifting_log_size < OMITTED_LAYERS {
+            return <Self as MerkleOpsLifted<Blake2sMerkleHasherGeneric<IS_M31_OUTPUT>>>::build_layers(columns, lifting_log_size);
+        }
+        let mut layer = <Self as MerkleOpsLifted<Blake2sMerkleHasherGeneric<IS_M31_OUTPUT>>>::build_leaves(columns, lifting_log_size);
+        for _ in 0..OMITTED_LAYERS {
+            layer = <Self as MerkleOpsLifted<Blake2sMerkleHasherGeneric<IS_M31_OUTPUT>>>::build_next_layer(&layer);
+        }
+        let mut layers: Vec<Vec<Blake2sHash>> = (0..OMITTED_LAYERS).map(|_| Vec::new()).collect();
+        layers.push(layer);
+        for _ in OMITTED_LAYERS..lifting_log_size {
+            layers.push(<Self as MerkleOpsLifted<Blake2sMerkleHasherGeneric<IS_M31_OUTPUT>>>::build_next_layer(layers.last().unwrap()));
+        }
+        layers
+    }
