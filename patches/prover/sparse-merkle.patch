+    #[test]
+    fn test_sparse_layers_keep_root_and_decommitment() {
+        // Lifted columns of three sizes; queries include siblings, duplicates and both ends.
+        const LOG_N_ROWS: u32 = 10;
+        let cols: Vec<Vec<BaseField>> = [LOG_N_ROWS, LOG_N_ROWS - 3, LOG_N_ROWS]
+            .iter()
+            .enumerate()
+            .map(|(c, &log)| (0..1u32 << log).map(|i| M31::from_u32_unchecked(i * 7 + c as u32)).collect())
+            .collect();
+        let simd_cols: Vec<BaseColumn> = cols.iter().map(|c| BaseColumn::from_cpu(c)).collect();
+        let queries = [0, 1, 5, 5, 300, 301, 777, 1023];
+        let cpu = MerkleProverLifted::<CpuBackend, Blake2sMerkleHasher>::commit(cols.iter().collect(), LOG_N_ROWS, 0);
+        let simd = MerkleProverLifted::<SimdBackend, Blake2sMerkleHasher>::commit(simd_cols.iter().collect(), LOG_N_ROWS, 0);
+        assert!(simd.layers.iter().rev().take(5).all(|layer| layer.is_empty()));
+        assert!(!simd.layers[LOG_N_ROWS as usize - 5].is_empty());
+        assert_eq!(cpu.root(), simd.root());
+        let (cpu_values, cpu_decommitment) = cpu.decommit(&queries, cols.iter().collect());
+        let (simd_values, simd_decommitment) = simd.decommit(&queries, simd_cols.iter().collect());
+        assert_eq!(cpu_values, simd_values);
+        assert_eq!(cpu_decommitment.decommitment.hash_witness, simd_decommitment.decommitment.hash_witness);
+    }
 }
