+#[cfg(test)]
+mod tests {
+    use super::BaseColumnPool;
+    use crate::core::fields::m31::BaseField;
+    use crate::prover::backend::cpu::CpuBackend;
+
+    #[test]
+    fn release_unused_preserves_checked_out_buffers_and_allows_reuse() {
+        let pool = BaseColumnPool::<CpuBackend>::new();
+        pool.reserve(3, 2);
+        let mut checked_out = pool.take(3);
+        checked_out.fill(BaseField::from(7));
+        let returned = pool.take(3);
+        pool.give_back(3, returned);
+
+        pool.release_unused();
+        assert!(pool.pools.is_empty());
+        assert_eq!(checked_out, vec![BaseField::from(7); 8]);
+
+        // Fresh pool buffers are uninitialized: write every element before reading.
+        let mut fresh = pool.take_or_alloc(3);
+        assert_eq!(fresh.len(), 8);
+        fresh.fill(BaseField::from(11));
+        pool.give_back(3, fresh);
+        assert_eq!(pool.take(3), vec![BaseField::from(11); 8]);
+
+        pool.give_back(3, checked_out);
+        assert_eq!(pool.take_or_alloc(3), vec![BaseField::from(7); 8]);
+    }
+}
