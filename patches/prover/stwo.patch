+    /// Drops buffers currently idle in the pool, leaving checked-out buffers untouched.
+    ///
+    /// Call between proving stages to make cached allocations available for reuse elsewhere.
+    /// Concurrent returns may add buffers again. After clearing, `take` requires a new
+    /// reservation or returned buffer; `take_or_alloc` can allocate as usual.
+    pub fn release_unused(&self) {
+        self.pools.clear();
+    }
+
     /// Pre-allocates `count` zero-initialized buffers of size `1 << log_size`.
     pub fn reserve(&self, log_size: u32, count: usize) {
         let mut pool = self.pools.entry(log_size).or_default();
