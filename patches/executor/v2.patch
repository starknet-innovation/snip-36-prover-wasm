+//! Construct transaction-specific storage witnesses using the pinned committer.
+//! Input is a full local synthetic facts DB, not a precomputed transaction witness.
+use blockifier::state::cached_state::{StateChangesKeys, StateMaps, StorageDiff, StorageView};
+use serde::Deserialize;
+use starknet_api::hash::StateRoots;
+use starknet_committer::block_committer::commit::commit_block;
+use starknet_committer::block_committer::input::{
+    Input,
+    ReaderConfig,
+    StarknetStorageKey,
+    StarknetStorageValue,
+    StateDiff,
+};
+use starknet_committer::block_committer::measurements_util::NoMeasurements;
+use starknet_committer::db::facts_db::db::FactsDb;
+use starknet_committer::db::facts_db::types::FactsDbInitialRead;
+use starknet_committer::db::forest_trait::{ForestWriter, StorageInitializer};
+use starknet_committer::patricia_merkle_tree::types::CompiledClassHash;
+use starknet_os::commitment_infos::StateCommitmentInfos;
+use starknet_patricia_storage::map_storage::MapStorage;
+use starknet_patricia_storage::storage_trait::{DbKey, DbValue};
+
+#[derive(Deserialize)]
+#[serde(deny_unknown_fields)]
+struct Database {
+    roots: StateRoots,
+    entries: Vec<(Vec<u8>, Vec<u8>)>,
+    scope: String,
+}
+
+pub fn regenerate(
+    database_json: &[u8],
+    diff: StateMaps,
+    keys: &StateChangesKeys,
+    expected_roots: StateRoots,
+) -> Result<StateCommitmentInfos, Box<dyn std::error::Error>> {
+    let database: Database = serde_json::from_slice(database_json)?;
+    if database.scope != "complete synthetic initial-state facts database" {
+        return Err("unsupported database scope".into());
+    }
+    if database.roots != expected_roots {
+        return Err("facts database roots differ from the selected base state".into());
+    }
+    // Match the virtual backend's supported transitions. Ordinary invoke nonce changes are allowed.
+    if !diff.class_hashes.is_empty()
+        || !diff.compiled_class_hashes.is_empty()
+        || diff.storage.values().any(|v| *v == starknet_types_core::felt::Felt::ZERO)
+    {
+        return Err(
+            "virtual OS does not support deployment, declaration, or storage deletion".into()
+        );
+    }
+    let diff = StateDiff {
+        address_to_class_hash: diff.class_hashes,
+        address_to_nonce: diff.nonces,
+        class_hash_to_compiled_class_hash: diff
+            .compiled_class_hashes
+            .into_iter()
+            .map(|(h, c)| (h, CompiledClassHash(c.0)))
+            .collect(),
+        storage_updates: StorageDiff::from(StorageView(diff.storage))
+            .into_iter()
+            .map(|(a, updates)| {
+                (
+                    a,
+                    updates
+                        .into_iter()
+                        .map(|(k, v)| (StarknetStorageKey(k), StarknetStorageValue(v)))
+                        .collect(),
+                )
+            })
+            .collect(),
+    };
+    let storage =
+        MapStorage(database.entries.into_iter().map(|(k, v)| (DbKey(k), DbValue(v))).collect());
+    // Pure CPU/map-storage futures. No sockets, filesystem, or timers are enabled.
+    let runtime = tokio::runtime::Builder::new_current_thread().build()?;
+    runtime.block_on(async {
+        let mut db = FactsDb::new(storage);
+        let input = Input {
+            state_diff: diff,
+            initial_read_context: FactsDbInitialRead(database.roots),
+            config: ReaderConfig::new(false, false),
+        };
+        let (forest, _) = commit_block(input, &mut db, &mut NoMeasurements).await?;
+        db.write(&forest).await?;
+        let updated = StateRoots {
+            contracts_trie_root_hash: forest.get_contract_root_hash(),
+            classes_trie_root_hash: forest.get_compiled_class_root_hash(),
+        };
+        let mut storage = db.consume_storage();
+        Ok(starknet_os::commitment_infos::build_state_commitment_infos(&database.roots, &updated, &mut storage, &blockifier::state::accessed_keys::AccessedKeys {
+            storage_keys: keys.storage_keys.iter().copied().collect(),
+            accessed_contracts: keys.modified_contracts.iter().copied().collect(),
+            accessed_class_hashes: keys.compiled_class_hash_keys.iter().copied().collect(),
+        }).await?)
+    })
+}
