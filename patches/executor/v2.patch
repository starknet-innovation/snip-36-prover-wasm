+#[cfg(target_arch = "wasm32")]
+mod alloc_metrics;
+#[cfg(target_arch = "wasm32")]
+#[global_allocator]
+static ALLOCATOR: alloc_metrics::MeteredAllocator = alloc_metrics::MeteredAllocator;
+#[cfg(target_arch = "wasm32")]
+#[wasm_bindgen::prelude::wasm_bindgen]
+pub fn allocation_metrics() -> String { alloc_metrics::snapshot() }
+pub mod public_admission;
+pub mod public_demo_signer;
+pub mod public_execution;
+pub mod public_witness;
+pub mod public_class;
+#[path="../../apollo_compilation_utils/src/class_utils.rs"]
+pub mod pinned_class_utils;
+pub mod public_header;
+pub mod public_state;
+// Minimal type adapters allow direct reuse of the pinned converter without its HTTP stack.
+pub mod errors {
+    #[derive(Debug,thiserror::Error)]
+    pub enum ProofProviderError {
+        #[error("Invalid state diff: {0}")] InvalidStateDiff(String),
+        #[error(transparent)] SerializationError(#[from] starknet_patricia_storage::errors::SerializationError),
+        #[error("Invalid RPC proof: {0}")] InvalidProofResponse(String),
+        #[error("Block commitment: {0}")] BlockCommitmentError(String),
+    }
+}
+pub mod running { pub mod storage_proofs {
+    #[derive(serde::Deserialize)]
+    #[serde(deny_unknown_fields)]
+    pub struct RpcStorageProofsQuery {
+        pub class_hashes: Vec<starknet_rust_core::types::Felt>,
+        pub contract_addresses: Vec<starknet_api::core::ContractAddress>,
+        #[serde(rename="contracts_storage_keys")]
+        pub contract_storage_keys: Vec<starknet_rust_core::types::ContractStorageKeys>,
+    }
+}}
+#[path="../../starknet_transaction_prover/src/running/committer_utils.rs"]
+pub mod pinned_committer_utils;
+pub mod preexecute;
+pub mod witness;
+// Executes pinned virtual OS hints locally. State acquisition and Blockifier preexecution
+// remain explicit preceding stages. This module does not construct a proof.
+use std::io::{Cursor, Write};
+
+use cairo_vm::vm::runners::cairo_pie::CairoPie;
+use wasm_bindgen::prelude::*;
+
+/// In-memory equivalent of CairoPie::write_zip_file(path, false).
+pub fn pie_zip(pie: &CairoPie) -> Result<Vec<u8>, Box<dyn std::error::Error>> {
+    let mut zip = zip::ZipWriter::new(Cursor::new(Vec::new()));
+    let options = zip::write::FileOptions::default()
+        .compression_method(zip::CompressionMethod::Deflated)
+        .large_file(true);
+    zip.start_file("version.json", options)?;
+    serde_json::to_writer(&mut zip, &pie.version)?;
+    zip.start_file("metadata.json", options)?;
+    serde_json::to_writer(&mut zip, &pie.metadata)?;
+    zip.start_file("memory.bin", options)?;
+    zip.write_all(&pie.memory.to_bytes(None))?;
+    zip.start_file("additional_data.json", options)?;
+    serde_json::to_writer(&mut zip, &pie.additional_data)?;
+    zip.start_file("execution_resources.json", options)?;
+    serde_json::to_writer(&mut zip, &pie.execution_resources)?;
+    Ok(zip.finish()?.into_inner())
+}
+
+pub fn execute_hints(hints_json: &[u8]) -> Result<(Vec<u8>, String), Box<dyn std::error::Error>> {
+    let hints: starknet_os::io::os_input::OsHints = serde_json::from_slice(hints_json)?;
+    if hints.os_hints_config.use_kzg_da {
+        return Err("virtual OS browser executor requires use_kzg_da=false".into());
+    }
+    let result = starknet_os::runner::run_virtual_os(hints)?;
+    result.cairo_pie.run_validity_checks()?;
+    // Strict native virtual-output parser checks version, message count and trailing fields.
+    starknet_os::io::virtual_os_output::VirtualOsOutput::from_raw_output(&result.raw_output)?;
+    let output = serde_json::to_string(&result.raw_output)?;
+    Ok((pie_zip(&result.cairo_pie)?, output))
+}
+
+#[wasm_bindgen]
+pub struct ExecutionResult {
+    pie: Vec<u8>,
+    output: String,
+}
+#[wasm_bindgen]
+impl ExecutionResult {
+    pub fn pie_bytes(&self) -> Vec<u8> {
+        self.pie.clone()
+    }
+    pub fn output_json(&self) -> String {
+        self.output.clone()
+    }
+}
+#[wasm_bindgen]
+pub fn run_virtual_os(hints_json: &[u8]) -> Result<ExecutionResult, JsValue> {
+    execute_hints(hints_json)
+        .map(|(pie, output)| ExecutionResult { pie, output })
+        .map_err(|e| JsValue::from_str(&e.to_string()))
+}
+
+#[wasm_bindgen]
+extern "C" {
+    #[wasm_bindgen(js_namespace = console, js_name = error)]
+    fn console_error(message: &str);
+}
+#[wasm_bindgen(start)]
+pub fn install_panic_hook() {
+    std::panic::set_hook(Box::new(|info| console_error(&info.to_string())));
+}
+
+/// Regenerates transaction call information from a complete local state snapshot.
+/// The input may have an empty tx_execution_infos array; it is never used by this stage.
+#[wasm_bindgen]
+pub fn prepare_transaction(hints_json: &[u8], snapshot_json: &[u8]) -> Result<String, JsValue> {
+    let prepare = || -> Result<String, Box<dyn std::error::Error>> {
+        let mut hints = serde_json::from_slice(hints_json)?;
+        preexecute::preexecute(&mut hints, snapshot_json)?;
+        Ok(serde_json::to_string(&hints)?)
+    };
+    prepare().map_err(|e| JsValue::from_str(&e.to_string()))
+}
+
+/// Start from a plain RPC transaction, recompute its hash, and execute locally.
+/// The supplied hints provide the base-block metadata, classes and storage witness.
+#[wasm_bindgen]
+pub fn prepare_rpc_transaction(
+    hints_json: &[u8],
+    snapshot_json: &[u8],
+    rpc_json: &[u8],
+) -> Result<String, JsValue> {
+    let prepare = || -> Result<String, Box<dyn std::error::Error>> {
+        let mut hints = serde_json::from_slice(hints_json)?;
+        preexecute::install_rpc_transaction(&mut hints, rpc_json, snapshot_json)?;
+        preexecute::preexecute(&mut hints, snapshot_json)?;
+        Ok(serde_json::to_string(&hints)?)
+    };
+    prepare().map_err(|e| JsValue::from_str(&e.to_string()))
+}
+
+/// Rebuild storage witnesses from the complete local facts database after browser execution.
+#[wasm_bindgen]
+pub fn prepare_rpc_with_witness(
+    hints_json: &[u8],
+    snapshot_json: &[u8],
+    rpc_json: &[u8],
+    database_json: &[u8],
+) -> Result<String, JsValue> {
+    let prepare = || -> Result<String, Box<dyn std::error::Error>> {
+        let mut hints = serde_json::from_slice(hints_json)?;
+        preexecute::install_rpc_transaction(&mut hints, rpc_json, snapshot_json)?;
+        preexecute::preexecute_with_witness(&mut hints, snapshot_json, Some(database_json))?;
+        Ok(serde_json::to_string(&hints)?)
+    };
+    prepare().map_err(|e| JsValue::from_str(&e.to_string()))
+}
diff --git a/crates/browser_virtual_os/src/preexecute.rs b/crates/browser_virtual_os/src/preexecute.rs
new file mode 100644
index 0000000..9ea0cfd
--- /dev/null
+++ b/crates/browser_virtual_os/src/preexecute.rs
@@ -0,0 +1,284 @@
+//! Offline preexecution against a complete synthetic test-chain snapshot.
+//! No RPC, implicit remote state, or fallback to native execution.
+use std::collections::{BTreeMap, HashMap};
+
+use blockifier::blockifier::config::TransactionExecutorConfig;
+use blockifier::blockifier::transaction_executor::TransactionExecutor;
+use blockifier::blockifier_versioned_constants::VersionedConstants;
+use blockifier::bouncer::BouncerConfig;
+use blockifier::context::{BlockContext, ChainInfo};
+use blockifier::execution::contract_class::{CompiledClassV1, RunnableCompiledClass};
+use blockifier::state::cached_state::{CachedState, StateMaps};
+use blockifier::state::errors::StateError;
+use blockifier::state::state_api::{StateReader, StateResult};
+use blockifier::transaction::transaction_execution::Transaction;
+use serde::Deserialize;
+use shared_execution_objects::central_objects::CentralTransactionExecutionInfo;
+use starknet_api::contract_class::SierraVersion;
+use starknet_api::core::{ClassHash, CompiledClassHash, ContractAddress, Nonce};
+use starknet_api::state::StorageKey;
+use starknet_api::versioned_constants_logic::VersionedConstantsTrait;
+use starknet_os::io::os_input::OsHints;
+use starknet_types_core::felt::Felt;
+
+#[derive(Deserialize)]
+#[serde(deny_unknown_fields)]
+struct Snapshot {
+    #[serde(default = "default_execution_mode")]
+    execution_mode: String,
+    state_maps: StateMaps,
+    sierra_versions: BTreeMap<ClassHash, SierraVersion>,
+    compiled_class_hashes_v2: BTreeMap<ClassHash, CompiledClassHash>,
+    chain_info: ChainInfo,
+    scope: String,
+}
+fn default_execution_mode() -> String {
+    "upstream_fixture".into()
+}
+struct SnapshotReader {
+    strict_missing: bool,
+    state: StateMaps,
+    classes: HashMap<ClassHash, RunnableCompiledClass>,
+    hashes_v2: BTreeMap<ClassHash, CompiledClassHash>,
+}
+impl SnapshotReader {
+    fn absent<T: Default>(&self, request: serde_json::Value) -> StateResult<T> {
+        if self.strict_missing {
+            Err(StateError::StateReadError(format!("BROWSER_STATE_MISS:{request}")))
+        } else {
+            Ok(T::default())
+        }
+    }
+}
+impl StateReader for SnapshotReader {
+    fn get_storage_at(&self, a: ContractAddress, k: StorageKey) -> StateResult<Felt> {
+        self.state.storage.get(&(a, k)).copied().map(Ok).unwrap_or_else(|| {
+            self.absent(serde_json::json!({"kind":"storage","address":a,"key":k}))
+        })
+    }
+    fn get_nonce_at(&self, a: ContractAddress) -> StateResult<Nonce> {
+        self.state
+            .nonces
+            .get(&a)
+            .copied()
+            .map(Ok)
+            .unwrap_or_else(|| self.absent(serde_json::json!({"kind":"nonce","address":a})))
+    }
+    fn get_class_hash_at(&self, a: ContractAddress) -> StateResult<ClassHash> {
+        self.state
+            .class_hashes
+            .get(&a)
+            .copied()
+            .map(Ok)
+            .unwrap_or_else(|| self.absent(serde_json::json!({"kind":"class_hash","address":a})))
+    }
+    fn get_compiled_class_hash(&self, h: ClassHash) -> StateResult<CompiledClassHash> {
+        self.state.compiled_class_hashes.get(&h).copied().map(Ok).unwrap_or_else(|| {
+            self.absent(serde_json::json!({"kind":"compiled_class_hash","class_hash":h}))
+        })
+    }
+    fn get_compiled_class(&self, h: ClassHash) -> StateResult<RunnableCompiledClass> {
+        self.classes.get(&h).cloned().ok_or(StateError::UndeclaredClassHash(h))
+    }
+    fn get_compiled_class_hash_v2(
+        &self,
+        h: ClassHash,
+        _c: &RunnableCompiledClass,
+    ) -> StateResult<CompiledClassHash> {
+        self.hashes_v2.get(&h).copied().ok_or(StateError::MissingCompiledClassHashV2(h))
+    }
+}
+
+/// Replace all native-prepared call information with fresh pinned Blockifier execution.
+/// The state-commitment witness remains supplied input and is checked by the virtual OS.
+pub fn preexecute(
+    hints: &mut OsHints,
+    snapshot_json: &[u8],
+) -> Result<String, Box<dyn std::error::Error>> {
+    preexecute_with_witness(hints, snapshot_json, None)
+}
+
+pub fn preexecute_with_witness(
+    hints: &mut OsHints,
+    snapshot_json: &[u8],
+    database_json: Option<&[u8]>,
+) -> Result<String, Box<dyn std::error::Error>> {
+    let snapshot: Snapshot = serde_json::from_slice(snapshot_json)?;
+    let strict_missing = match snapshot.scope.as_str() {
+        "complete synthetic test-chain state; absence means zero" => false,
+        "partial state cache; unknown entries are errors" => true,
+        _ => return Err("unsupported state snapshot scope".into()),
+    };
+    if hints.os_input.os_block_inputs.len() != 1 {
+        return Err("expected one block".into());
+    }
+    let block = &mut hints.os_input.os_block_inputs[0];
+    if block.transactions.len() != 1 {
+        return Err("expected one transaction".into());
+    }
+    if !matches!(
+        block.transactions[0],
+        starknet_api::executable_transaction::Transaction::Account(
+            starknet_api::executable_transaction::AccountTransaction::Invoke(_)
+        )
+    ) {
+        return Err("expected Invoke".into());
+    }
+    if snapshot.chain_info.chain_id != hints.os_hints_config.chain_info.chain_id
+        || snapshot.chain_info.fee_token_addresses.strk_fee_token_address
+            != hints.os_hints_config.chain_info.strk_fee_token_address
+    {
+        return Err("snapshot chain identity mismatch".into());
+    }
+    let mut classes = HashMap::new();
+    for (hash, version) in &snapshot.sierra_versions {
+        let compiled_hash =
+            snapshot.compiled_class_hashes_v2.get(hash).ok_or("missing V2 class identity")?;
+        let casm =
+            hints.os_input.compiled_classes.get(compiled_hash).ok_or("missing compiled class")?;
+        classes.insert(
+            *hash,
+            RunnableCompiledClass::V1(CompiledClassV1::try_from((casm.clone(), version.clone()))?),
+        );
+    }
+    let reader = SnapshotReader {
+        strict_missing,
+        state: snapshot.state_maps,
+        classes,
+        hashes_v2: snapshot.compiled_class_hashes_v2,
+    };
+    let mut state = CachedState::new(reader);
+    // These are the exact pinned upstream flow-test context and sequencing flags.
+    let mut constants = VersionedConstants::latest_constants().clone();
+    let (transaction, bouncer) = match snapshot.execution_mode.as_str() {
+        "upstream_fixture" => {
+            (Transaction::new_for_sequencing(block.transactions[0].clone()), BouncerConfig::max())
+        }
+        "backend_zero_fee" => {
+            constants.disable_casm_hash_migration();
+            constants.min_sierra_version_for_sierra_gas = SierraVersion::new(0, 0, 1);
+            let starknet_api::executable_transaction::Transaction::Account(
+                starknet_api::executable_transaction::AccountTransaction::Invoke(invoke),
+            ) = &block.transactions[0]
+            else {
+                unreachable!()
+            };
+            let tx = Transaction::from_api(
+                starknet_api::transaction::Transaction::Invoke(invoke.tx.clone()),
+                invoke.tx_hash,
+                None,
+                None,
+                None,
+                blockifier::transaction::account_transaction::ExecutionFlags {
+                    only_query: false,
+                    charge_fee: false,
+                    validate: true,
+                    strict_nonce_check: false,
+                },
+            )?;
+            (tx, BouncerConfig::default())
+        }
+        _ => return Err("unsupported execution mode".into()),
+    };
+    let context =
+        BlockContext::new(block.block_info.clone(), snapshot.chain_info, constants, bouncer);
+    // Same single-transaction execution and capacity gate as the RPC backend.
+    // No block preprocessing or native worker pool is used.
+    let mut executor =
+        TransactionExecutor::new(state, context.clone(), TransactionExecutorConfig::default());
+    let (execution, _) = executor.execute(&transaction)?;
+    state = executor.block_state.take().ok_or("transaction executor state unavailable")?;
+    if let Some(error) = execution.revert_error {
+        return Err(format!("virtual transaction reverted: {error}").into());
+    }
+    if let Some(database_json) = database_json {
+        // Same extended-read collection used by the upstream flow-test builder.
+        let reads = state.get_initial_reads()?;
+        for address in reads.get_contract_addresses() {
+            state.get_class_hash_at(address)?;
+            state.get_nonce_at(address)?;
+        }
+        for hash in reads.declared_contracts.keys() {
+            state.get_compiled_class_hash(*hash)?;
+        }
+        let mut initial_reads = state.get_initial_reads()?;
+        initial_reads.declared_contracts.clear();
+        let diff = state.to_state_diff()?.state_maps;
+        let commitment_diff = diff.clone().into();
+        let mut constants = context.versioned_constants().clone();
+        constants.enable_stateful_compression = false;
+        let accessed = blockifier::state::accessed_keys::AccessedKeys::new(
+            [&execution],
+            [],
+            &commitment_diff,
+            &constants,
+        );
+        let keys = blockifier::state::cached_state::StateChangesKeys {
+            nonce_keys: Default::default(),
+            class_hash_keys: Default::default(),
+            storage_keys: accessed.storage_keys.into_iter().collect(),
+            compiled_class_hash_keys: accessed.accessed_class_hashes.into_iter().collect(),
+            modified_contracts: accessed.accessed_contracts.into_iter().collect(),
+        };
+        let infos = crate::witness::regenerate(
+            database_json,
+            diff,
+            &keys,
+            starknet_api::hash::StateRoots {
+                contracts_trie_root_hash: block.contract_state_commitment_info.previous_root,
+                classes_trie_root_hash: block.contract_class_commitment_info.previous_root,
+            },
+        )?;
+        block.initial_reads = initial_reads;
+        block.contract_state_commitment_info = infos.contracts_trie_commitment_info;
+        block.contract_class_commitment_info = infos.classes_trie_commitment_info;
+        block.address_to_storage_commitment_info = infos.storage_tries_commitment_infos;
+    }
+    let execution: CentralTransactionExecutionInfo = execution.into();
+    let result = serde_json::to_string(&execution)?;
+    block.tx_execution_infos = vec![execution];
+    Ok(result)
+}
+
+/// Install a plain RPC invoke, computing its transaction hash with pinned Starknet API code.
+/// Fee/input checks mirror the backend's default input policy; this local adapter only
+/// supports the explicit complete-snapshot execution mode, not RPC state acquisition.
+pub fn install_rpc_transaction(
+    hints: &mut OsHints,
+    rpc_json: &[u8],
+    snapshot_json: &[u8],
+) -> Result<(), Box<dyn std::error::Error>> {
+    let snapshot: Snapshot = serde_json::from_slice(snapshot_json)?;
+    if snapshot.execution_mode != "backend_zero_fee" {
+        return Err("RPC input requires backend_zero_fee snapshot mode".into());
+    }
+    let rpc: starknet_api::rpc_transaction::RpcInvokeTransactionV3 =
+        serde_json::from_slice(rpc_json)?;
+    if !rpc.proof.is_empty() || !rpc.proof_facts.is_empty() {
+        return Err("proof and proof_facts must be empty on input".into());
+    }
+    let bounds = &rpc.resource_bounds;
+    if rpc.tip.0 != 0
+        || bounds.l1_gas.max_price_per_unit.0 != 0
+        || bounds.l2_gas.max_price_per_unit.0 != 0
+        || bounds.l1_data_gas.max_price_per_unit.0 != 0
+    {
+        return Err("all input gas prices and tip must be zero".into());
+    }
+    if bounds.l2_gas.max_amount.0 == 0 {
+        return Err("L2 gas amount must be nonzero".into());
+    }
+    if hints.os_input.os_block_inputs.len() != 1 {
+        return Err("expected one block".into());
+    }
+    let invoke = starknet_api::executable_transaction::InvokeTransaction::create(
+        starknet_api::transaction::InvokeTransaction::V3(rpc.into()),
+        &snapshot.chain_info.chain_id,
+    )?;
+    hints.os_input.os_block_inputs[0].transactions =
+        vec![starknet_api::executable_transaction::Transaction::Account(
+            starknet_api::executable_transaction::AccountTransaction::Invoke(invoke),
+        )];
+    hints.os_input.os_block_inputs[0].tx_execution_infos.clear();
+    Ok(())
+}
diff --git a/crates/browser_virtual_os/src/public_admission.rs b/crates/browser_virtual_os/src/public_admission.rs
new file mode 100644
index 0000000..e7ae005
--- /dev/null
+++ b/crates/browser_virtual_os/src/public_admission.rs
@@ -0,0 +1,27 @@
+//! Scoped proof-fact admission using unchanged pinned Blockifier prevalidation.
+//! Fee payment, account validation, execution and consensus inclusion are outside this check.
+use starknet_api::executable_transaction::AccountTransaction as Transaction;
+use std::collections::{HashMap,BTreeMap};
+use blockifier::{blockifier_versioned_constants::VersionedConstants,bouncer::BouncerConfig,context::BlockContext,state::cached_state::{CachedState,StateMaps},transaction::account_transaction::{AccountTransaction,ExecutionFlags}};
+use starknet_api::{core::OsChainInfo,transaction::{InvokeTransaction,fields::ProofFacts},versioned_constants_logic::VersionedConstantsTrait};
+use starknet_types_core::felt::Felt;
+use crate::public_execution::{ExecutionRequest,PublicReader};
+pub fn check(proof_bytes:&[u8],request_bytes:&[u8],facts_bytes:&[u8])->Result<String,Box<dyn std::error::Error>>{
+ let checked:serde_json::Value=serde_json::from_str(&crate::public_state::authenticate_and_convert(proof_bytes)?)?;
+ let initial:StateMaps=serde_json::from_value(checked["initial_reads"].clone())?;
+ let input:crate::public_state::PublicProofInput=serde_json::from_slice(proof_bytes)?;
+ let mut request:ExecutionRequest=serde_json::from_slice(request_bytes)?;
+ if Felt::from_hex(&request.chain_info.chain_id.as_hex())?!=request.captured_chain_id{return Err("Admission chain differs from captured chain".into());}
+ if request.chain_info.is_l3{return Err("L3 admission context unsupported".into());}
+ let facts:ProofFacts=serde_json::from_slice(facts_bytes)?;
+ if facts.0.is_empty(){return Err("Empty facts are not SNIP-36 admission evidence".into());}
+ request.transaction.proof_facts=facts;
+ let invoke=starknet_api::executable_transaction::InvokeTransaction::create(InvokeTransaction::V3(request.transaction.into()),&request.chain_info.chain_id)?;
+ let block_info=input.header.block_info()?;
+ let config=OsChainInfo::from(&request.chain_info).compute_virtual_os_config_hash(block_info.starknet_version)?;
+ let context=BlockContext::new(block_info,request.chain_info,VersionedConstants::latest_constants().clone(),BouncerConfig::default());
+ let tx=AccountTransaction{tx:Transaction::Invoke(invoke),execution_flags:ExecutionFlags{only_query:false,charge_fee:false,validate:true,strict_nonce_check:true}};
+ let mut state=CachedState::new(PublicReader{state:initial,classes:HashMap::new(),hashes_v2:BTreeMap::new()});
+ tx.perform_pre_validation_stage(&mut state,&context.to_tx_context(&tx))?;
+ Ok(serde_json::to_string(&serde_json::json!({"admission":"accepted","admission_block_hash":input.block_hash,"admission_block_number":input.header.block_number,"config_hash":config,"chain_id":request.captured_chain_id,"scope":"Unchanged pinned nonce and proof version/program/block-age/stored-block-hash/config gates against authenticated RPC state; fees and account signature validation not checked","network_acceptance_tested":false}))?)
+}
diff --git a/crates/browser_virtual_os/src/public_class.rs b/crates/browser_virtual_os/src/public_class.rs
new file mode 100644
index 0000000..89d43da
--- /dev/null
+++ b/crates/browser_virtual_os/src/public_class.rs
@@ -0,0 +1,60 @@
+//! Uses the pinned native in-process Sierra compilation function verbatim.
+use blockifier::state::{errors::StateError,state_api::StateResult};
+use cairo_lang_starknet_classes::{allowed_libfuncs::ListSelector,casm_contract_class::CasmContractClass};
+use starknet_api::contract_class::{ContractClass,SierraVersion};
+use starknet_api::state::SierraContractClass;
+use crate::pinned_class_utils::into_contract_class_for_compilation;
+// Pinned apollo_sierra_compilation_config::config::DEFAULT_MAX_BYTECODE_SIZE.
+const DEFAULT_MAX_BYTECODE_SIZE:usize=80*1024;
+pub fn sierra_to_versioned_contract_class_v1(
+    sierra_contract: SierraContractClass,
+) -> StateResult<(ContractClass, SierraVersion)> {
+    let sierra_version = SierraVersion::extract_from_program(&sierra_contract.sierra_program)
+        .map_err(|err| {
+            StateError::StateReadError(format!("Failed to extract Sierra version: {err}"))
+        })?;
+    let contract_class_for_compilation = into_contract_class_for_compilation(&sierra_contract);
+    let extracted_sierra_program =
+        contract_class_for_compilation.extract_sierra_program(false).map_err(|err| {
+            StateError::StateReadError(format!("Failed to extract the Sierra program: {err}"))
+        })?;
+    // Re-execution must accept any class the network accepted; do not restrict to the audited
+    // libfuncs list.
+    extracted_sierra_program
+        .validate_version_compatible(ListSelector::ListName("all".to_string()))
+        .map_err(|err| {
+            StateError::StateReadError(format!("Sierra program version validation failed: {err}"))
+        })?;
+    let casm_contract_class = CasmContractClass::from_contract_class(
+        contract_class_for_compilation,
+        extracted_sierra_program,
+        // Add pythonic hints, as the sequencer does when compiling declared classes.
+        true,
+        // Generous bound; declared classes already passed the network's bytecode-size limit.
+        10 * DEFAULT_MAX_BYTECODE_SIZE,
+    )
+    .map_err(|err| {
+        StateError::StateReadError(format!("Failed to compile Sierra to Casm: {err}"))
+    })?;
+
+    Ok((ContractClass::V1((casm_contract_class, sierra_version.clone())), sierra_version))
+}
+
+#[derive(serde::Deserialize)]
+#[serde(deny_unknown_fields)]
+struct Input { class_hash:starknet_api::core::ClassHash, class: SierraContractClass }
+pub fn compile_public_class(bytes:&[u8])->Result<String,Box<dyn std::error::Error>>{
+ use starknet_api::contract_class::compiled_class_hash::{HashVersion,HashableCompiledClass};
+ use starknet_committer::{hash_function::hash::TreeHashFunctionImpl,patricia_merkle_tree::types::CompiledClassHash};
+ use starknet_patricia::patricia_merkle_tree::updated_skeleton_tree::hash_function::TreeHashFunction;
+ let input:Input=serde_json::from_slice(bytes)?;
+ if input.class.calculate_class_hash()!=input.class_hash{return Err("Sierra class hash mismatch".into());}
+ let (class,version)=sierra_to_versioned_contract_class_v1(input.class)?;
+ let ContractClass::V1((casm,_))=class else {return Err("Expected Cairo1 class".into());};
+ let hash_v1=casm.hash(&HashVersion::V1);let hash_v2=casm.hash(&HashVersion::V2);
+ let leaf_v1=TreeHashFunctionImpl::compute_leaf_hash(&CompiledClassHash(hash_v1.0));
+ let leaf_v2=TreeHashFunctionImpl::compute_leaf_hash(&CompiledClassHash(hash_v2.0));
+ Ok(serde_json::to_string(&serde_json::json!({"class_hash":input.class_hash,"sierra_version":version,"compiled_hash_v1":hash_v1,"compiled_hash_v2":hash_v2,"leaf_v1":leaf_v1,"leaf_v2":leaf_v2,"casm":casm,"scope":"Sierra identity checked; pinned native compiler used locally; match compiled class leaf to authenticated classes-tree path separately"}))?)
+}
+#[wasm_bindgen::prelude::wasm_bindgen]
+pub fn compile_captured_class(bytes:&[u8])->Result<String,wasm_bindgen::JsValue>{compile_public_class(bytes).map_err(|e|wasm_bindgen::JsValue::from_str(&e.to_string()))}
