+//! Real-header virtual execution and OS input assembly. No synthetic hint template is accepted.
+use std::collections::{BTreeMap,HashMap};
+use blockifier::{blockifier::{config::TransactionExecutorConfig,transaction_executor::TransactionExecutor},blockifier_versioned_constants::VersionedConstants,bouncer::BouncerConfig,context::{BlockContext,ChainInfo},execution::contract_class::{CompiledClassV1,RunnableCompiledClass},state::{cached_state::{CachedState,StateMaps},errors::StateError,state_api::{StateReader,StateResult}},transaction::transaction_execution::Transaction};
+use cairo_lang_starknet_classes::casm_contract_class::CasmContractClass;
+use serde::Deserialize;
+use shared_execution_objects::central_objects::CentralTransactionExecutionInfo;
+use starknet_api::{block::{BlockHash,BlockInfo},block_hash::block_hash_calculator::{BlockHeaderCommitments,concat_counts},contract_class::SierraVersion,core::{ClassHash,CompiledClassHash,ContractAddress,Nonce,OsChainInfo},state::StorageKey,transaction::{InvokeTransaction,TransactionHash},versioned_constants_logic::VersionedConstantsTrait};
+use starknet_os::{commitment_infos::CommitmentInfo,io::os_input::{OsBlockInput,OsHints,OsHintsConfig,StarknetOsInput}};
+use starknet_types_core::felt::Felt;
+pub(crate) struct VirtualOsBlockInput {
+    contract_state_commitment_info: CommitmentInfo,
+    address_to_storage_commitment_info: HashMap<ContractAddress, CommitmentInfo>,
+    contract_class_commitment_info: CommitmentInfo,
+    chain_info: OsChainInfo,
+    transactions: Vec<(InvokeTransaction, TransactionHash)>,
+    tx_execution_infos: Vec<CentralTransactionExecutionInfo>,
+    block_info: BlockInfo,
+    /// The base block's version string as returned by the RPC; used by the OS to recompute the
+    /// base block hash (may be newer than the latest known `StarknetVersion`).
+    raw_starknet_version: String,
+    initial_reads: StateMaps,
+    base_block_hash: BlockHash,
+    base_block_header_commitments: BlockHeaderCommitments,
+    prev_base_block_hash: BlockHash,
+    compiled_classes: BTreeMap<CompiledClassHash, CasmContractClass>,
+}
+
+impl From<VirtualOsBlockInput> for OsHints {
+    fn from(virtual_os_block_input: VirtualOsBlockInput) -> Self {
+        let os_block_input = OsBlockInput {
+            block_hash_commitments: virtual_os_block_input.base_block_header_commitments,
+            contract_state_commitment_info: virtual_os_block_input.contract_state_commitment_info,
+            address_to_storage_commitment_info: virtual_os_block_input
+                .address_to_storage_commitment_info,
+            contract_class_commitment_info: virtual_os_block_input.contract_class_commitment_info,
+            transactions: virtual_os_block_input
+                .transactions
+                .into_iter()
+                .map(|(invoke_tx, tx_hash)| {
+                    starknet_api::executable_transaction::Transaction::Account(
+                        starknet_api::executable_transaction::AccountTransaction::Invoke(
+                            starknet_api::executable_transaction::InvokeTransaction {
+                                tx: invoke_tx,
+                                tx_hash,
+                            },
+                        ),
+                    )
+                })
+                .collect(),
+            tx_execution_infos: virtual_os_block_input.tx_execution_infos,
+            prev_block_hash: virtual_os_block_input.prev_base_block_hash,
+            block_info: virtual_os_block_input.block_info,
+            starknet_version_override: Some(virtual_os_block_input.raw_starknet_version),
+            initial_reads: virtual_os_block_input.initial_reads,
+            declared_class_hash_to_component_hashes: HashMap::new(),
+            new_block_hash: virtual_os_block_input.base_block_hash,
+            old_block_number_and_hash: None,
+            class_hashes_to_migrate: Vec::new(),
+        };
+
+        let os_input = StarknetOsInput {
+            os_block_inputs: vec![os_block_input],
+            deprecated_compiled_classes: BTreeMap::new(),
+            compiled_classes: virtual_os_block_input.compiled_classes,
+        };
+
+        OsHints {
+            os_input,
+            os_hints_config: OsHintsConfig {
+                debug_mode: false,
+                full_output: false,
+                use_kzg_da: false,
+                chain_info: virtual_os_block_input.chain_info,
+                public_keys: None,
+                rng_seed_salt: None,
+            },
+        }
+    }
+}
+
+pub(crate) struct PublicReader {
+    pub(crate) state: StateMaps,
+    pub(crate) classes: HashMap<ClassHash, RunnableCompiledClass>,
+    pub(crate) hashes_v2: BTreeMap<ClassHash, CompiledClassHash>,
+}
+impl PublicReader {
+    fn absent<T>(&self,request:serde_json::Value)->StateResult<T>{
+        Err(StateError::StateReadError(format!("BROWSER_STATE_MISS:{request}")))
+    }
+}
+impl StateReader for PublicReader {
+    fn get_storage_at(&self, a: ContractAddress, k: StorageKey) -> StateResult<Felt> {
+        self.state.storage.get(&(a, k)).copied().map(Ok).unwrap_or_else(|| {
+            self.absent(serde_json::json!({"kind":"storage","address":a,"key":k}))
+        })
+    }
+    fn get_nonce_at(&self, a: ContractAddress) -> StateResult<Nonce> {
+        self.state
+            .nonces
+            .get(&a)
+            .copied()
+            .map(Ok)
+            .unwrap_or_else(|| self.absent(serde_json::json!({"kind":"nonce","address":a})))
+    }
+    fn get_class_hash_at(&self, a: ContractAddress) -> StateResult<ClassHash> {
+        self.state
+            .class_hashes
+            .get(&a)
+            .copied()
+            .map(Ok)
+            .unwrap_or_else(|| self.absent(serde_json::json!({"kind":"class_hash","address":a})))
+    }
+    fn get_compiled_class_hash(&self, h: ClassHash) -> StateResult<CompiledClassHash> {
+        self.state.compiled_class_hashes.get(&h).copied().map(Ok).unwrap_or_else(|| {
+            self.absent(serde_json::json!({"kind":"compiled_class_hash","class_hash":h}))
+        })
+    }
+    fn get_compiled_class(&self, h: ClassHash) -> StateResult<RunnableCompiledClass> {
+        self.classes.get(&h).cloned().map(Ok).unwrap_or_else(||self.absent(serde_json::json!({"kind":"class","class_hash":h})))
+    }
+    fn get_compiled_class_hash_v2(
+        &self,
+        h: ClassHash,
+        _c: &RunnableCompiledClass,
+    ) -> StateResult<CompiledClassHash> {
+        self.hashes_v2.get(&h).copied().ok_or(StateError::MissingCompiledClassHashV2(h))
+    }
+}
+
+
+#[derive(Deserialize)]
+#[serde(deny_unknown_fields)]
+pub struct ExecutionRequest {
+ pub captured_chain_id:Felt,
+ pub chain_info:ChainInfo,
+ pub transaction:starknet_api::rpc_transaction::RpcInvokeTransactionV3,
+}
+#[derive(Deserialize)]
+struct Prepared {
+ initial_reads:StateMaps,
+ compiled_classes:BTreeMap<CompiledClassHash,CasmContractClass>,
+ sierra_versions:BTreeMap<ClassHash,SierraVersion>,
+ compiled_class_hashes_v2:BTreeMap<ClassHash,CompiledClassHash>,
+}
+
+pub fn create_public_hints(proof_bytes:&[u8],classes_bytes:&[u8],request_bytes:&[u8])->Result<(OsHints,String),Box<dyn std::error::Error>>{
+ let request:ExecutionRequest=serde_json::from_slice(request_bytes)?;
+ if Felt::from_hex(&request.chain_info.chain_id.as_hex())?!=request.captured_chain_id{return Err("Execution chain differs from captured RPC chain".into());}
+ if request.chain_info.is_l3{return Err("Public-chain adapter does not support L3 context".into());}
+ // Canonical STRK token from backend snip36-core/src/types.rs.
+ let strk=Felt::from_hex("0x04718f5a0fc34cc1af16a1cdee98ffb20c31f5cd61d6ab07201858f4287c938d")?;
+ if **request.chain_info.fee_token_addresses.strk_fee_token_address!=strk{return Err("Unexpected public-chain STRK token".into());}
+ let rpc=request.transaction;
+ if rpc.signature.0.is_empty(){return Err("Representative public invocation requires a signature".into());}
+ if !rpc.proof.is_empty() || !rpc.proof_facts.is_empty(){return Err("proof and proof_facts must be empty on input".into());}
+ let bounds=&rpc.resource_bounds;
+ if rpc.tip.0!=0 || bounds.l1_gas.max_price_per_unit.0!=0 || bounds.l2_gas.max_price_per_unit.0!=0 || bounds.l1_data_gas.max_price_per_unit.0!=0{return Err("All input gas prices and tip must be zero".into());}
+ if bounds.l2_gas.max_amount.0==0{return Err("L2 gas amount must be nonzero".into());}
+ let prepared:Prepared=serde_json::from_str(&crate::public_state::prepare_state(proof_bytes,classes_bytes)?)?;
+ let input:crate::public_state::PublicProofInput=serde_json::from_slice(proof_bytes)?;
+ let mut classes=HashMap::new();
+ for (hash,version) in &prepared.sierra_versions{
+  let compiled_hash=prepared.compiled_class_hashes_v2.get(hash).ok_or("Missing authenticated V2 hash")?;
+  let casm=prepared.compiled_classes.get(compiled_hash).ok_or("Missing authenticated CASM")?;
+  classes.insert(*hash,RunnableCompiledClass::V1(CompiledClassV1::try_from((casm.clone(),version.clone()))?));
+ }
+ let initial=prepared.initial_reads;
+ let reader=PublicReader{state:initial.clone(),classes,hashes_v2:prepared.compiled_class_hashes_v2};
+ let invoke=starknet_api::executable_transaction::InvokeTransaction::create(InvokeTransaction::V3(rpc.into()),&request.chain_info.chain_id)?;
+ let block_info=input.header.block_info()?;
+ let mut constants=VersionedConstants::latest_constants().clone();constants.disable_casm_hash_migration();constants.min_sierra_version_for_sierra_gas=SierraVersion::new(0,0,1);
+ let context=BlockContext::new(block_info.clone(),request.chain_info.clone(),constants,BouncerConfig::default());
+ let transaction=Transaction::from_api(starknet_api::transaction::Transaction::Invoke(invoke.tx.clone()),invoke.tx_hash,None,None,None,blockifier::transaction::account_transaction::ExecutionFlags{only_query:false,charge_fee:false,validate:true,strict_nonce_check:false})?;
+ let mut executor=TransactionExecutor::new(CachedState::new(reader),context,TransactionExecutorConfig::default());
+ let (execution,_)=executor.execute(&transaction)?;
+ if let Some(error)=&execution.revert_error{return Err(format!("Public virtual invocation reverted: {error}").into());}
+ let mut state=executor.block_state.take().ok_or("Execution state unavailable")?;
+ let diff=state.to_state_diff()?.state_maps;
+ let infos=crate::public_witness::commit_authenticated(&input.proof,&input.query,&initial,diff.clone())?;
+ let message_hashes=starknet_os::io::virtual_os_output::compute_messages_to_l1_hashes(&execution.accumulated_sorted_l2_to_l1_messages());
+ let config_hash=OsChainInfo::from(&request.chain_info).compute_virtual_os_config_hash(block_info.starknet_version)?;
+ let central:CentralTransactionExecutionInfo=execution.into();
+ let report=serde_json::to_string(&serde_json::json!({"transaction_hash":invoke.tx_hash,"block_hash":input.block_hash,"chain_id":request.captured_chain_id,"execution":central,"state_diff":diff,"expected_config_hash":config_hash,"expected_message_hashes":message_hashes,"scope":"Pinned Blockifier execution with authenticated public inputs; network submission not performed"}))?;
+ let header=input.header;
+ let hints:OsHints=VirtualOsBlockInput{
+  contract_state_commitment_info:infos.contracts_trie_commitment_info,address_to_storage_commitment_info:infos.storage_tries_commitment_infos,contract_class_commitment_info:infos.classes_trie_commitment_info,
+  chain_info:OsChainInfo::from(&request.chain_info),transactions:vec![(invoke.tx,invoke.tx_hash)],tx_execution_infos:vec![central],block_info,raw_starknet_version:header.starknet_version,
+  initial_reads:initial,base_block_hash:header.block_hash,base_block_header_commitments:BlockHeaderCommitments{transaction_commitment:header.transaction_commitment,event_commitment:header.event_commitment,receipt_commitment:header.receipt_commitment,state_diff_commitment:header.state_diff_commitment,concatenated_counts:concat_counts(header.transaction_count,header.event_count,header.state_diff_length,header.l1_da_mode)},prev_base_block_hash:header.parent_hash,compiled_classes:prepared.compiled_classes,
+ }.into();
+ Ok((hints,report))
+}
+#[wasm_bindgen::prelude::wasm_bindgen]
+pub fn public_preexecute(proof_bytes:&[u8],classes_bytes:&[u8],request_bytes:&[u8])->Result<String,wasm_bindgen::JsValue>{
+ create_public_hints(proof_bytes,classes_bytes,request_bytes).and_then(|(hints,report)|Ok(serde_json::to_string(&serde_json::json!({"hints":hints,"execution":serde_json::from_str::<serde_json::Value>(&report)?}))?)).map_err(|e|wasm_bindgen::JsValue::from_str(&e.to_string()))
+}
