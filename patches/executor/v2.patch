index 0000000..775b714
--- /dev/null
+++ b/crates/browser_virtual_os/src/public_state.rs
@@ -0,0 +1,263 @@
+//! Verify RPC Patricia paths before using the unchanged pinned proof-to-facts converter.
+//! The supplied header root must separately be authenticated/reconstructed by the caller.
+use std::collections::HashSet;
+
+use blockifier::state::cached_state::StateMaps;
+use indexmap::IndexMap;
+use serde::Deserialize;
+use starknet_api::core::{ClassHash, ContractAddress, Nonce};
+use starknet_api::hash::{HashOutput, StateRoots};
+use starknet_committer::block_committer::input::StarknetStorageValue;
+use starknet_committer::hash_function::hash::TreeHashFunctionImpl;
+use starknet_committer::patricia_merkle_tree::leaf::leaf_impl::ContractState;
+use starknet_committer::patricia_merkle_tree::types::CompiledClassHash;
+use starknet_patricia::patricia_merkle_tree::node_data::inner_node::NodeData;
+use starknet_patricia::patricia_merkle_tree::node_data::leaf::Leaf;
+use starknet_patricia::patricia_merkle_tree::updated_skeleton_tree::hash_function::TreeHashFunction;
+use starknet_rust_core::types::{Felt, MerkleNode, StorageProof};
+
+use crate::running::storage_proofs::RpcStorageProofsQuery;
+
+type Result<T> = std::result::Result<T, Box<dyn std::error::Error>>;
+fn bit(value: Felt, index: usize) -> bool {
+    let bytes = value.to_bytes_be();
+    (bytes[31 - index / 8] >> (index % 8)) & 1 == 1
+}
+fn trie_key(value: Felt) -> Result<()> {
+    if (251..256).any(|i| bit(value, i)) {
+        return Err("Patricia key exceeds 251 bits".into());
+    }
+    Ok(())
+}
+// Check lengths before pinned NodeData conversion, whose upstream API assumes valid edges.
+fn validate_nodes<L: Leaf>(nodes: &IndexMap<Felt, MerkleNode>) -> Result<()>
+where
+    TreeHashFunctionImpl: TreeHashFunction<L>,
+{
+    for (hash, node) in nodes {
+        if let MerkleNode::EdgeNode(edge) = node {
+            if edge.length == 0
+                || edge.length > 251
+                || (edge.length as usize..256).any(|i| bit(edge.path, i))
+            {
+                return Err("Invalid Patricia edge path/length".into());
+            }
+        }
+        let data: NodeData<L, HashOutput> = NodeData::from(node);
+        if TreeHashFunctionImpl::compute_node_hash(&data).0 != *hash {
+            return Err("Patricia node hash mismatch".into());
+        }
+    }
+    Ok(())
+}
+// Returns the authenticated terminal leaf digest, or zero for an authenticated absent path.
+fn lookup(nodes: &IndexMap<Felt, MerkleNode>, root: Felt, key: Felt) -> Result<Felt> {
+    trie_key(key)?;
+    let (mut current, mut depth) = (root, 0usize);
+    while current != Felt::ZERO && depth < 251 {
+        let node = nodes.get(&current).ok_or("Incomplete Patricia path")?;
+        match node {
+            MerkleNode::BinaryNode(n) => {
+                current = if bit(key, 250 - depth) { n.right } else { n.left };
+                depth += 1;
+            }
+            MerkleNode::EdgeNode(n) => {
+                let length = n.length as usize;
+                if length == 0 || depth + length > 251 {
+                    return Err("Patricia edge exceeds remaining height".into());
+                }
+                for offset in 0..length {
+                    if bit(key, 250 - depth - offset) != bit(n.path, length - 1 - offset) {
+                        return Ok(Felt::ZERO);
+                    }
+                }
+                depth += length;
+                current = n.child;
+            }
+        }
+    }
+    Ok(current)
+}
+#[derive(Deserialize)]
+#[serde(deny_unknown_fields)]
+pub struct PublicProofInput {
+    pub header: crate::public_header::BlockHeader,
+    pub block_hash: Felt,
+    pub state_root: Felt,
+    pub query: RpcStorageProofsQuery,
+    pub proof: StorageProof,
+    pub storage_reads: Vec<StorageRead>,
+}
+#[derive(Deserialize)]
+#[serde(deny_unknown_fields)]
+pub struct StorageRead {
+    pub address: ContractAddress,
+    pub key: starknet_api::state::StorageKey,
+    pub value: Felt,
+}
+
+pub fn authenticate_and_convert(bytes: &[u8]) -> Result<String> {
+    // Reject duplicate serialized node identities before IndexMap deserialization could overwrite
+    // them.
+    let raw: serde_json::Value = serde_json::from_slice(bytes)?;
+    let mut lists = vec![&raw["proof"]["classes_proof"], &raw["proof"]["contracts_proof"]["nodes"]];
+    if let Some(storage) = raw["proof"]["contracts_storage_proofs"].as_array() {
+        lists.extend(storage.iter());
+    }
+    for list in lists {
+        let mut seen = HashSet::new();
+        for node in list.as_array().ok_or("Expected proof node array")? {
+            let hash: Felt = serde_json::from_value(node["node_hash"].clone())?;
+            if !seen.insert(hash) {
+                return Err("Duplicate proof node identity".into());
+            }
+        }
+    }
+    let input: PublicProofInput = serde_json::from_value(raw)?;
+    crate::public_header::check_header(&input.header)?;
+    if input.header.block_hash.0 != input.block_hash || input.header.new_root.0 != input.state_root
+    {
+        return Err("Selected anchor disagrees with header".into());
+    }
+    let proof = &input.proof;
+    let query = &input.query;
+    if proof.global_roots.block_hash != input.block_hash {
+        return Err("Mixed-block proof".into());
+    }
+    let roots = StateRoots {
+        contracts_trie_root_hash: HashOutput(proof.global_roots.contracts_tree_root),
+        classes_trie_root_hash: HashOutput(proof.global_roots.classes_tree_root),
+    };
+    if roots.global_root().0 != input.state_root {
+        return Err("Proof roots do not match header state root".into());
+    }
+    validate_nodes::<ContractState>(&proof.contracts_proof.nodes)?;
+    validate_nodes::<CompiledClassHash>(&proof.classes_proof)?;
+    for nodes in &proof.contracts_storage_proofs {
+        validate_nodes::<StarknetStorageValue>(nodes)?;
+    }
+    if query.contract_addresses.len() != proof.contracts_proof.contract_leaves_data.len()
+        || query.contract_storage_keys.len() != proof.contracts_storage_proofs.len()
+    {
+        return Err("Proof positional length mismatch".into());
+    }
+    let mut initial = StateMaps::default();
+    let mut addresses = HashSet::new();
+    let mut class_hashes = HashSet::new();
+    let mut storage_roots = std::collections::HashMap::new();
+    for (address, leaf) in
+        query.contract_addresses.iter().zip(&proof.contracts_proof.contract_leaves_data)
+    {
+        if !addresses.insert(*address) {
+            return Err("Duplicate contract query".into());
+        }
+        let root = leaf.storage_root.unwrap_or(Felt::ZERO);
+        let actual = lookup(
+            &proof.contracts_proof.nodes,
+            proof.global_roots.contracts_tree_root,
+            ***address,
+        )?;
+        let state = ContractState {
+            class_hash: ClassHash(leaf.class_hash),
+            nonce: Nonce(leaf.nonce),
+            storage_root_hash: HashOutput(root),
+        };
+        if actual == Felt::ZERO {
+            if leaf.class_hash != Felt::ZERO || leaf.nonce != Felt::ZERO || root != Felt::ZERO {
+                return Err("Nonempty leaf for absent contract".into());
+            }
+        } else if TreeHashFunctionImpl::compute_leaf_hash(&state).0 != actual {
+            return Err("Contract leaf differs from authenticated path".into());
+        }
+        initial.class_hashes.insert(*address, ClassHash(leaf.class_hash));
+        initial.nonces.insert(*address, Nonce(leaf.nonce));
+        storage_roots.insert(*address, root);
+    }
+    let mut class_leaves = Vec::new();
+    for hash in &query.class_hashes {
+        if !class_hashes.insert(*hash) {
+            return Err("Duplicate class query".into());
+        }
+        class_leaves.push((
+            *hash,
+            lookup(&proof.classes_proof, proof.global_roots.classes_tree_root, *hash)?,
+        ));
+    }
+    let mut requested = HashSet::new();
+    let mut storage_contracts = HashSet::new();
+    for (request, nodes) in query.contract_storage_keys.iter().zip(&proof.contracts_storage_proofs)
+    {
+        let address = ContractAddress::try_from(request.contract_address)?;
+        if !storage_contracts.insert(address) {
+            return Err("Duplicate storage contract query".into());
+        }
+        let root = *storage_roots
+            .get(&address)
+            .ok_or("Storage proof missing authenticated contract leaf")?;
+        for key in &request.storage_keys {
+            let storage_key = starknet_api::state::StorageKey::try_from(*key)?;
+            if !requested.insert((address, storage_key)) {
+                return Err("Duplicate storage key query".into());
+            }
+            let actual = lookup(nodes, root, *key)?;
+            initial.storage.insert((address, storage_key), actual);
+        }
+    }
+    let mut supplied = HashSet::new();
+    for read in input.storage_reads {
+        if !supplied.insert((read.address, read.key)) {
+            return Err("Duplicate storage read".into());
+        }
+        if initial.storage.get(&(read.address, read.key)) != Some(&read.value) {
+            return Err("Storage value differs from authenticated path".into());
+        }
+    }
+    if supplied != requested {
+        return Err("Missing storage read for requested proof".into());
+    }
+    let db =
+        crate::pinned_committer_utils::create_facts_db_from_storage_proof(proof, query, &initial)?;
+    let mut entries: Vec<_> = db.consume_storage().0.into_iter().map(|(k, v)| (k.0, v.0)).collect();
+    entries.sort();
+    Ok(serde_json::to_string(
+        &serde_json::json!({"roots":roots,"entries":entries,"initial_reads":initial,"class_leaf_hashes":class_leaves,"compiled_class_preimages_verified":false,"header_authenticated":false,"header_hash_checked":true,"scope":"Patricia paths and storage reads checked against supplied header state root; header authenticity and compiled class preimages require separate checks"}),
+    )?)
+}
+#[wasm_bindgen::prelude::wasm_bindgen]
+pub fn convert_public_proof(bytes: &[u8]) -> std::result::Result<String, wasm_bindgen::JsValue> {
+    authenticate_and_convert(bytes).map_err(|e| wasm_bindgen::JsValue::from_str(&e.to_string()))
+}
+
+/// Complete the facts database with class preimages produced by the pinned compiler.
+/// The selected native backend uses compiled hash V2; a V1 commitment is rejected explicitly.
+pub fn prepare_state(proof_bytes:&[u8],classes_bytes:&[u8])->Result<String>{
+    let mut facts:serde_json::Value=serde_json::from_str(&authenticate_and_convert(proof_bytes)?)?;
+    let input:PublicProofInput=serde_json::from_slice(proof_bytes)?;
+    let mut initial:StateMaps=serde_json::from_value(facts["initial_reads"].clone())?;
+    let class_leaves:Vec<(Felt,Felt)>=serde_json::from_value(facts["class_leaf_hashes"].clone())?;
+    let classes:Vec<serde_json::Value>=serde_json::from_slice(classes_bytes)?;
+    let mut seen=HashSet::new();let mut compiled=std::collections::BTreeMap::new();
+    let mut versions=std::collections::BTreeMap::new();let mut hashes=std::collections::BTreeMap::new();
+    for class in classes {
+        let result:serde_json::Value=serde_json::from_str(&crate::public_class::compile_public_class(&serde_json::to_vec(&class)?)?)?;
+        let hash:ClassHash=serde_json::from_value(result["class_hash"].clone())?;
+        if !seen.insert(hash.0){return Err("Duplicate captured class".into());}
+        let actual=class_leaves.iter().find(|(h,_)|*h==hash.0).ok_or("Class is not included in authenticated query")?.1;
+        let expected:Felt=serde_json::from_value(result["leaf_v2"].clone())?;
+        if actual==Felt::ZERO || actual!=expected{return Err("Compiled class V2 preimage differs from authenticated class leaf".into());}
+        let compiled_hash:starknet_api::core::CompiledClassHash=serde_json::from_value(result["compiled_hash_v2"].clone())?;
+        initial.compiled_class_hashes.insert(hash,compiled_hash);
+        versions.insert(hash,result["sierra_version"].clone());hashes.insert(hash,compiled_hash);
+        compiled.insert(compiled_hash,result["casm"].clone());
+    }
+    if seen!=input.query.class_hashes.iter().copied().collect(){return Err("Missing captured class for authenticated query".into());}
+    let db=crate::pinned_committer_utils::create_facts_db_from_storage_proof(&input.proof,&input.query,&initial)?;
+    let mut entries:Vec<_>=db.consume_storage().0.into_iter().map(|(k,v)|(k.0,v.0)).collect();entries.sort();
+    facts["entries"]=serde_json::to_value(entries)?;facts["initial_reads"]=serde_json::to_value(initial)?;
+    facts["compiled_classes"]=serde_json::to_value(compiled)?;facts["sierra_versions"]=serde_json::to_value(versions)?;
+    facts["compiled_class_hashes_v2"]=serde_json::to_value(hashes)?;facts["compiled_class_preimages_verified"]=true.into();
+    facts["scope"]="Header hash, Patricia paths, storage values, Sierra identities, and pinned-compiler V2 class preimages checked; network trust remains tied to the selected public RPC snapshot".into();
+    Ok(serde_json::to_string(&facts)?)
+}
+#[wasm_bindgen::prelude::wasm_bindgen]
+pub fn prepare_public_state(proof_bytes:&[u8],classes_bytes:&[u8])->std::result::Result<String,wasm_bindgen::JsValue>{prepare_state(proof_bytes,classes_bytes).map_err(|e|wasm_bindgen::JsValue::from_str(&e.to_string()))}
