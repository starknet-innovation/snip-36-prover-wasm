@@ -0,0 +1,101 @@
+//! Header shape copied unchanged from pinned blockifier_reexecution RPC objects.
+//! Hash order mirrors pinned calculate_block_hash; only raw version-string support is added,
+//! as required by the pinned native virtual executor / OS version override.
+use serde::{Deserialize, Serialize};
+use starknet_api::StarknetApiError;
+use starknet_api::block::{
+    BlockHash,
+    BlockNumber,
+    BlockTimestamp,
+    GasPricePerToken,
+    StarknetVersion,
+};
+use starknet_api::block_hash::block_hash_calculator::{
+    BlockHashVersion,
+    concat_counts,
+    gas_prices_to_hash,
+};
+use starknet_api::core::{
+    ContractAddress,
+    EventCommitment,
+    GlobalRoot,
+    ReceiptCommitment,
+    StateDiffCommitment,
+    TransactionCommitment,
+    ascii_as_felt,
+};
+use starknet_types_core::hash::{Poseidon,StarkHash};
+use starknet_api::data_availability::L1DataAvailabilityMode;
+use starknet_types_core::felt::Felt;
+#[derive(Clone, Debug, Default, Deserialize, Serialize)]
+pub struct BlockHeader {
+    pub block_hash: BlockHash,
+    pub parent_hash: BlockHash,
+    pub block_number: BlockNumber,
+    pub sequencer_address: ContractAddress,
+    pub new_root: GlobalRoot,
+    pub timestamp: BlockTimestamp,
+    pub l1_gas_price: GasPricePerToken,
+    pub l1_data_gas_price: GasPricePerToken,
+    pub l2_gas_price: GasPricePerToken,
+    pub l1_da_mode: L1DataAvailabilityMode,
+    pub starknet_version: String,
+    pub state_diff_commitment: StateDiffCommitment,
+    pub event_commitment: EventCommitment,
+    pub receipt_commitment: ReceiptCommitment,
+    pub transaction_commitment: TransactionCommitment,
+    pub transaction_count: usize,
+    pub event_count: usize,
+    pub state_diff_length: usize,
+}
+
+// Copied unchanged from pinned virtual_block_executor.rs.
+pub fn starknet_version_or_latest(
+    version_string: &str,
+) -> Result<StarknetVersion, StarknetApiError> {
+    match StarknetVersion::try_from(version_string) {
+        Err(StarknetApiError::InvalidStarknetVersion(segments))
+            if segments > Vec::<u8>::from(StarknetVersion::LATEST) =>
+        {
+            Ok(StarknetVersion::LATEST)
+        }
+        result => result,
+    }
+}
+pub fn check_header(header: &BlockHeader) -> Result<(), Box<dyn std::error::Error>> {
+    let version: BlockHashVersion =
+        starknet_version_or_latest(&header.starknet_version)?.try_into()?;
+    let counts = concat_counts(
+        header.transaction_count,
+        header.event_count,
+        header.state_diff_length,
+        header.l1_da_mode,
+    );
+    // HashChain is crate-private; retain its exact array construction and pinned Poseidon primitive.
+    let mut fields=vec![version.clone().into(), header.block_number.0.into(),header.new_root.0,
+        **header.sequencer_address,header.timestamp.0.into(),counts,header.state_diff_commitment.0.0,
+        header.transaction_commitment.0,header.event_commitment.0,header.receipt_commitment.0];
+    fields.extend(gas_prices_to_hash(&header.l1_gas_price,&header.l1_data_gas_price,&header.l2_gas_price,&version));
+    fields.extend([ascii_as_felt(&header.starknet_version)?,Felt::ZERO,header.parent_hash.0]);
+    let calculated=Poseidon::hash_array(&fields);
+    if calculated != header.block_hash.0 {
+        return Err("Header block hash reconstruction mismatch".into());
+    }
+    Ok(())
+}
+
+impl BlockHeader {
+    /// Pinned RPC BlockHeader conversion with the native virtual-executor version selection.
+    pub fn block_info(&self)->Result<starknet_api::block::BlockInfo,Box<dyn std::error::Error>>{
+        use starknet_api::block::{BlockInfo,GasPrices,GasPriceVector,GasPrice,NonzeroGasPrice};
+        let nonzero=|v:GasPrice|NonzeroGasPrice::new(v).map_err(|_|"Zero gas price in public block header");
+        Ok(BlockInfo{
+            block_number:self.block_number,sequencer_address:self.sequencer_address,block_timestamp:self.timestamp,
+            gas_prices:GasPrices{
+                eth_gas_prices:GasPriceVector{l1_gas_price:nonzero(self.l1_gas_price.price_in_wei)?,l1_data_gas_price:nonzero(self.l1_data_gas_price.price_in_wei)?,l2_gas_price:nonzero(self.l2_gas_price.price_in_wei)?},
+                strk_gas_prices:GasPriceVector{l1_gas_price:nonzero(self.l1_gas_price.price_in_fri)?,l1_data_gas_price:nonzero(self.l1_data_gas_price.price_in_fri)?,l2_gas_price:nonzero(self.l2_gas_price.price_in_fri)?},
+            },
+            use_kzg_da:self.l1_da_mode.is_use_kzg_da(),starknet_version:starknet_version_or_latest(&self.starknet_version)?,
+        })
+    }
+}
