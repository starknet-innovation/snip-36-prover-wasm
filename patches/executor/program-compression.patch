+#[cfg(target_family = "wasm")]
+fn decompress_browser_program(compressed: &[u8]) -> Vec<u8> {
+    use std::io::Read;
+    let mut bytes=Vec::new();
+    flate2::read::GzDecoder::new(compressed).read_to_end(&mut bytes).expect("decompress pinned browser program");
+    bytes
