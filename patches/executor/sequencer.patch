+use starknet_api::transaction::fields::{ProofFacts, ProofFactsVariant};
+fn main() -> Result<(), Box<dyn std::error::Error>> {
+    let path = std::env::args().nth(1).ok_or("expected proof facts JSON path")?;
+    let facts: ProofFacts = serde_json::from_slice(&std::fs::read(path)?)?;
+    match ProofFactsVariant::try_from(&facts) {
+        Ok(ProofFactsVariant::Snos(s)) => println!(
+            "{}",
+            serde_json::json!({
+                "admission_format": "accepted", "program_hash": format!("{:#x}",s.program_hash),
+                "proof_version": s.proof_version.to_string(), "block_number":s.block_number.0,
+                "block_hash":format!("{:#x}",s.block_hash.0),"config_hash":format!("{:#x}",s.config_hash),
+                "network_acceptance_tested":false
+            })
+        ),
+        Ok(ProofFactsVariant::Empty) => {
+            return Err("empty facts are not a virtual OS statement".into());
+        }
+        Err(e) => {
+            println!(
+                "{}",
+                serde_json::json!({"admission_format":"rejected","error":e.to_string(),"network_acceptance_tested":false})
+            );
+            std::process::exit(1);
+        }
+    }
+    Ok(())
+}
