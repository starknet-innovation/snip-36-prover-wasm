+fn main() -> Result<(), Box<dyn std::error::Error>> {
+    let args: Vec<String> = std::env::args().collect();
+    if args.len() != 4 {
+        return Err("usage: preexecute_hints HINTS SNAPSHOT OUTPUT_DIR".into());
+    }
+    let mut hints: starknet_os::io::os_input::OsHints =
+        serde_json::from_slice(&std::fs::read(&args[1])?)?;
+    let expected = serde_json::to_value(&hints.os_input.os_block_inputs[0].tx_execution_infos[0])?;
+    let started = std::time::Instant::now();
+    let actual = browser_virtual_os::preexecute::preexecute(&mut hints, &std::fs::read(&args[2])?)?;
+    let preexecution_ms = started.elapsed().as_millis();
+    let dir = std::path::Path::new(&args[3]);
+    std::fs::create_dir_all(dir)?;
+    std::fs::write(dir.join("execution_info.json"), &actual)?;
+    let actual: serde_json::Value = serde_json::from_str(&actual)?;
+    std::fs::write(
+        dir.join("expected_execution_info.json"),
+        serde_json::to_vec_pretty(&expected)?,
+    )?;
+    if normalize(actual) != normalize(expected) {
+        return Err("reexecuted call information differs from upstream fixture; inspect saved \
+                    JSON"
+            .into());
+    }
+    let regenerated = serde_json::to_vec(&hints)?;
+    std::fs::write(dir.join("os_hints.json"), &regenerated)?;
+    let t = std::time::Instant::now();
+    let (pie, output) = browser_virtual_os::execute_hints(&regenerated)?;
+    let execution_ms = t.elapsed().as_millis();
+    std::fs::write(dir.join("cairo_pie.zip"), pie)?;
+    std::fs::write(dir.join("virtual_os_output.json"), output)?;
+    println!(
+        "{}",
+        serde_json::json!({"preexecution_ms":preexecution_ms,"virtual_os_execution_ms":execution_ms,"execution_info_matches_upstream":true,"origin":"native-snapshot-reexecution"})
+    );
+    Ok(())
+}
+
+// The pinned CallInfo stores these three tracker fields as HashSet, so serialization
+// order is not semantic. Preserve every ordered trace, read-value and call array.
+fn normalize(mut v: serde_json::Value) -> serde_json::Value {
+    match &mut v {
+        serde_json::Value::Object(map) => {
+            if let Some(serde_json::Value::Object(tracker)) = map.get_mut("storage_access_tracker")
+            {
+                for key in
+                    ["accessed_storage_keys", "accessed_contract_addresses", "accessed_blocks"]
+                {
+                    if let Some(serde_json::Value::Array(a)) = tracker.get_mut(key) {
+                        a.sort_by_key(|x| x.to_string());
+                    }
+                }
+            }
+            for val in map.values_mut() {
+                *val = normalize(val.take());
+            }
+        }
+        serde_json::Value::Array(a) => {
+            for val in a {
+                *val = normalize(val.take());
+            }
+        }
+        _ => {}
+    }
+    v
+}
