+pub mod preexecute;
+pub mod witness;
+// Executes pinned virtual OS hints locally. State acquisition and Blockifier preexecution
+// remain explicit preceding stages. This module does not construct a proof.
+use std::io::{Cursor, Write};
+
+use cairo_vm::vm::runners::cairo_pie::CairoPie;
+use wasm_bindgen::prelude::*;
+
+/// In-memory equivalent of CairoPie::write_zip_file(path, false).
+pub fn pie_zip(pie: &CairoPie) -> Result<Vec<u8>, Box<dyn std::error::Error>> {
+    let mut zip = zip::ZipWriter::new(Cursor::new(Vec::new()));
+    let options = zip::write::FileOptions::default()
+        .compression_method(zip::CompressionMethod::Deflated)
+        .large_file(true);
+    zip.start_file("version.json", options)?;
+    serde_json::to_writer(&mut zip, &pie.version)?;
+    zip.start_file("metadata.json", options)?;
+    serde_json::to_writer(&mut zip, &pie.metadata)?;
+    zip.start_file("memory.bin", options)?;
+    zip.write_all(&pie.memory.to_bytes(None))?;
+    zip.start_file("additional_data.json", options)?;
+    serde_json::to_writer(&mut zip, &pie.additional_data)?;
+    zip.start_file("execution_resources.json", options)?;
+    serde_json::to_writer(&mut zip, &pie.execution_resources)?;
+    Ok(zip.finish()?.into_inner())
+}
+
+pub fn execute_hints(hints_json: &[u8]) -> Result<(Vec<u8>, String), Box<dyn std::error::Error>> {
+    let hints: starknet_os::io::os_input::OsHints = serde_json::from_slice(hints_json)?;
+    if hints.os_hints_config.use_kzg_da {
+        return Err("virtual OS browser executor requires use_kzg_da=false".into());
+    }
+    let result = starknet_os::runner::run_virtual_os(hints)?;
+    result.cairo_pie.run_validity_checks()?;
+    // Strict native virtual-output parser checks version, message count and trailing fields.
+    starknet_os::io::virtual_os_output::VirtualOsOutput::from_raw_output(&result.raw_output)?;
+    let output = serde_json::to_string(&result.raw_output)?;
+    Ok((pie_zip(&result.cairo_pie)?, output))
+}
+
+#[wasm_bindgen]
+pub struct ExecutionResult {
+    pie: Vec<u8>,
+    output: String,
+}
+#[wasm_bindgen]
+impl ExecutionResult {
+    pub fn pie_bytes(&self) -> Vec<u8> {
+        self.pie.clone()
+    }
+    pub fn output_json(&self) -> String {
+        self.output.clone()
+    }
+}
+#[wasm_bindgen]
+pub fn run_virtual_os(hints_json: &[u8]) -> Result<ExecutionResult, JsValue> {
+    execute_hints(hints_json)
+        .map(|(pie, output)| ExecutionResult { pie, output })
+        .map_err(|e| JsValue::from_str(&e.to_string()))
+}
+
+#[wasm_bindgen]
+extern "C" {
+    #[wasm_bindgen(js_namespace = console, js_name = error)]
+    fn console_error(message: &str);
+}
+#[wasm_bindgen(start)]
+pub fn install_panic_hook() {
+    std::panic::set_hook(Box::new(|info| console_error(&info.to_string())));
+}
+
+/// Regenerates transaction call information from a complete local state snapshot.
+/// The input may have an empty tx_execution_infos array; it is never used by this stage.
+#[wasm_bindgen]
+pub fn prepare_transaction(hints_json: &[u8], snapshot_json: &[u8]) -> Result<String, JsValue> {
+    let prepare = || -> Result<String, Box<dyn std::error::Error>> {
+        let mut hints = serde_json::from_slice(hints_json)?;
+        preexecute::preexecute(&mut hints, snapshot_json)?;
+        Ok(serde_json::to_string(&hints)?)
+    };
+    prepare().map_err(|e| JsValue::from_str(&e.to_string()))
+}
+
+/// Start from a plain RPC transaction, recompute its hash, and execute locally.
+/// The supplied hints provide the base-block metadata, classes and storage witness.
+#[wasm_bindgen]
+pub fn prepare_rpc_transaction(
+    hints_json: &[u8],
+    snapshot_json: &[u8],
+    rpc_json: &[u8],
+) -> Result<String, JsValue> {
+    let prepare = || -> Result<String, Box<dyn std::error::Error>> {
+        let mut hints = serde_json::from_slice(hints_json)?;
+        preexecute::install_rpc_transaction(&mut hints, rpc_json, snapshot_json)?;
+        preexecute::preexecute(&mut hints, snapshot_json)?;
+        Ok(serde_json::to_string(&hints)?)
+    };
+    prepare().map_err(|e| JsValue::from_str(&e.to_string()))
+}
+
+/// Rebuild storage witnesses from the complete local facts database after browser execution.
+#[wasm_bindgen]
+pub fn prepare_rpc_with_witness(
+    hints_json: &[u8],
+    snapshot_json: &[u8],
+    rpc_json: &[u8],
+    database_json: &[u8],
+) -> Result<String, JsValue> {
+    let prepare = || -> Result<String, Box<dyn std::error::Error>> {
+        let mut hints = serde_json::from_slice(hints_json)?;
+        preexecute::install_rpc_transaction(&mut hints, rpc_json, snapshot_json)?;
+        preexecute::preexecute_with_witness(&mut hints, snapshot_json, Some(database_json))?;
+        Ok(serde_json::to_string(&hints)?)
+    };
+    prepare().map_err(|e| JsValue::from_str(&e.to_string()))
+}
