+// Local browser-port evidence. These tests exercise the unchanged private admission gates.
+#[cfg(test)]
+mod browser_fixture_admission_tests {
+    use starknet_api::block::BlockInfo;
+    use starknet_api::rpc_transaction::RpcInvokeTransactionV3;
+    use starknet_api::transaction::fields::ProofFacts;
+    use starknet_api::versioned_constants_logic::VersionedConstantsTrait;
+
+    use super::*;
+    use crate::blockifier_versioned_constants::VersionedConstants;
+    use crate::bouncer::BouncerConfig;
+    use crate::context::ChainInfo;
+    use crate::state::cached_state::CachedState;
+    use crate::test_utils::dict_state_reader::DictStateReader;
+
+    #[test]
+    #[ignore = "requires BROWSER_ADMISSION_FIXTURE and BROWSER_PROOF_FACTS"]
+    fn browser_generated_facts_admission_gates() {
+        let fixture = std::path::PathBuf::from(std::env::var("BROWSER_ADMISSION_FIXTURE").unwrap());
+        let read = |name: &str| -> serde_json::Value {
+            serde_json::from_slice(&std::fs::read(fixture.join(name)).unwrap()).unwrap()
+        };
+        let snapshot = read("state_snapshot.json");
+        let chain: ChainInfo = serde_json::from_value(snapshot["chain_info"].clone()).unwrap();
+        let hints = read("os_hints.json");
+        let mut block: BlockInfo =
+            serde_json::from_value(hints["os_input"]["os_block_inputs"][0]["block_info"].clone())
+                .unwrap();
+        let facts: Vec<Felt> = serde_json::from_slice(
+            &std::fs::read(std::env::var("BROWSER_PROOF_FACTS").unwrap()).unwrap(),
+        )
+        .unwrap();
+        let proof_block: u64 = facts[4].try_into().unwrap();
+        block.block_number = BlockNumber(proof_block + STORED_BLOCK_HASH_BUFFER);
+        let constants = VersionedConstants::latest_constants().clone();
+        let block_hash_address =
+            constants.os_constants.os_contract_addresses.block_hash_contract_address();
+        let context = BlockContext::new(
+            block.clone(),
+            chain.clone(),
+            constants.clone(),
+            BouncerConfig::default(),
+        );
+        let make_tx = |facts: Vec<Felt>| {
+            let mut rpc: RpcInvokeTransactionV3 =
+                serde_json::from_value(read("rpc_transaction.json")).unwrap();
+            rpc.proof_facts = ProofFacts(facts.into());
+            let invoke = starknet_api::executable_transaction::InvokeTransaction::create(
+                starknet_api::transaction::InvokeTransaction::V3(rpc.into()),
+                &chain.chain_id,
+            )
+            .unwrap();
+            AccountTransaction::new_with_default_flags(Transaction::Invoke(invoke))
+        };
+        let mut reader = DictStateReader::default();
+        reader.storage_view.insert((block_hash_address, StorageKey::from(proof_block)), facts[5]);
+        let mut state = CachedState::new(reader);
+        make_tx(facts.clone()).validate_proof_facts(&context, &mut state).unwrap();
+        for (index, label) in [(2, "program hash"), (5, "block hash"), (6, "config hash")] {
+            let mut bad = facts.clone();
+            bad[index] += Felt::ONE;
+            assert!(make_tx(bad).validate_proof_facts(&context, &mut state).is_err(), "{label}");
+        }
+        block.block_number = BlockNumber(proof_block + STORED_BLOCK_HASH_BUFFER - 1);
+        let recent = BlockContext::new(block, chain.clone(), constants, BouncerConfig::default());
+        assert!(make_tx(facts).validate_proof_facts(&recent, &mut state).is_err());
+        println!(
+            "Browser proof facts passed unchanged program/version/block/config gates in an \
+             explicit synthetic context; all four context mutations rejected. No network \
+             acceptance tested."
+        );
+    }
+}
