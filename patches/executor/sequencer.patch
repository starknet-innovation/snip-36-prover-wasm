+fn main() -> Result<(), Box<dyn std::error::Error>> {
+    let args: Vec<String> = std::env::args().collect();
+    if args.len() != 3 {
+        return Err("usage: execute_hints OS_HINTS_JSON OUTPUT_DIR".into());
+    }
+    let input = std::fs::read(&args[1])?;
+    let started = std::time::Instant::now();
+    let (pie, output) = browser_virtual_os::execute_hints(&input)?;
+    let elapsed = started.elapsed().as_millis();
+    let dir = std::path::Path::new(&args[2]);
+    std::fs::create_dir_all(dir)?;
+    std::fs::write(dir.join("cairo_pie.zip"), &pie)?;
+    std::fs::write(dir.join("virtual_os_output.json"), output)?;
+    println!(
+        "{}",
+        serde_json::json!({"execution_ms":elapsed,"pie_bytes":pie.len(),"origin":"native-hints-replay","proving":false})
+    );
+    Ok(())
+}
