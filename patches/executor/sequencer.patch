+fn main() -> Result<(), Box<dyn std::error::Error>> {
+    let args: Vec<String> = std::env::args().collect();
+    if args.len() != 5 && args.len() != 6 {
+        return Err("usage: execute_rpc HINTS SNAPSHOT RPC_TRANSACTION OUTPUT_DIR \
+                    [STATE_DATABASE]"
+            .into());
+    }
+    let mut hints = serde_json::from_slice(&std::fs::read(&args[1])?)?;
+    let snapshot = std::fs::read(&args[2])?;
+    let rpc = std::fs::read(&args[3])?;
+    browser_virtual_os::preexecute::install_rpc_transaction(&mut hints, &rpc, &snapshot)?;
+    let started = std::time::Instant::now();
+    let database = if args.len() == 6 { Some(std::fs::read(&args[5])?) } else { None };
+    let execution = browser_virtual_os::preexecute::preexecute_with_witness(
+        &mut hints,
+        &snapshot,
+        database.as_deref(),
+    )?;
+    let preexecution_ms = started.elapsed().as_millis();
+    let dir = std::path::Path::new(&args[4]);
+    std::fs::create_dir_all(dir)?;
+    std::fs::write(dir.join("execution_info.json"), execution)?;
+    let regenerated = serde_json::to_vec(&hints)?;
+    std::fs::write(dir.join("os_hints.json"), &regenerated)?;
+    let t = std::time::Instant::now();
+    let (pie, output) = browser_virtual_os::execute_hints(&regenerated)?;
+    std::fs::write(dir.join("cairo_pie.zip"), pie)?;
+    std::fs::write(dir.join("virtual_os_output.json"), output)?;
+    println!(
+        "{}",
+        serde_json::json!({"preexecution_ms":preexecution_ms,"virtual_os_execution_ms":t.elapsed().as_millis(),"rpc_transaction_hash_computed":true,"origin":"native-rpc-snapshot-execution"})
+    );
+    Ok(())
+}
