+//! Uses the pinned native in-process Sierra compilation function verbatim.
+use blockifier::state::{errors::StateError,state_api::StateResult};
+use cairo_lang_starknet_classes::{allowed_libfuncs::ListSelector,casm_contract_class::CasmContractClass};
+use starknet_api::contract_class::{ContractClass,SierraVersion};
+use starknet_api::state::SierraContractClass;
+use crate::pinned_class_utils::into_contract_class_for_compilation;
+// Pinned apollo_sierra_compilation_config::config::DEFAULT_MAX_BYTECODE_SIZE.
+const DEFAULT_MAX_BYTECODE_SIZE:usize=80*1024;
+pub fn sierra_to_versioned_contract_class_v1(
+    sierra_contract: SierraContractClass,
+) -> StateResult<(ContractClass, SierraVersion)> {
+    let sierra_version = SierraVersion::extract_from_program(&sierra_contract.sierra_program)
+        .map_err(|err| {
+            StateError::StateReadError(format!("Failed to extract Sierra version: {err}"))
+        })?;
+    let contract_class_for_compilation = into_contract_class_for_compilation(&sierra_contract);
+    let extracted_sierra_program =
+        contract_class_for_compilation.extract_sierra_program(false).map_err(|err| {
+            StateError::StateReadError(format!("Failed to extract the Sierra program: {err}"))
+        })?;
+    // Re-execution must accept any class the network accepted; do not restrict to the audited
+    // libfuncs list.
+    extracted_sierra_program
+        .validate_version_compatible(ListSelector::ListName("all".to_string()))
+        .map_err(|err| {
+            StateError::StateReadError(format!("Sierra program version validation failed: {err}"))
+        })?;
+    let casm_contract_class = CasmContractClass::from_contract_class(
+        contract_class_for_compilation,
+        extracted_sierra_program,
+        // Add pythonic hints, as the sequencer does when compiling declared classes.
+        true,
+        // Generous bound; declared classes already passed the network's bytecode-size limit.
+        10 * DEFAULT_MAX_BYTECODE_SIZE,
+    )
+    .map_err(|err| {
+        StateError::StateReadError(format!("Failed to compile Sierra to Casm: {err}"))
+    })?;
+
+    Ok((ContractClass::V1((casm_contract_class, sierra_version.clone())), sierra_version))
+}
+
+#[derive(serde::Deserialize)]
+#[serde(deny_unknown_fields)]
+struct Input { class_hash:starknet_api::core::ClassHash, class: SierraContractClass }
+pub fn compile_public_class(bytes:&[u8])->Result<String,Box<dyn std::error::Error>>{
+ use starknet_api::contract_class::compiled_class_hash::{HashVersion,HashableCompiledClass};
+ use starknet_committer::{hash_function::hash::TreeHashFunctionImpl,patricia_merkle_tree::types::CompiledClassHash};
+ use starknet_patricia::patricia_merkle_tree::updated_skeleton_tree::hash_function::TreeHashFunction;
+ let input:Input=serde_json::from_slice(bytes)?;
+ if input.class.calculate_class_hash()!=input.class_hash{return Err("Sierra class hash mismatch".into());}
+ let (class,version)=sierra_to_versioned_contract_class_v1(input.class)?;
+ let ContractClass::V1((casm,_))=class else {return Err("Expected Cairo1 class".into());};
+ let hash_v1=casm.hash(&HashVersion::V1);let hash_v2=casm.hash(&HashVersion::V2);
+ let leaf_v1=TreeHashFunctionImpl::compute_leaf_hash(&CompiledClassHash(hash_v1.0));
+ let leaf_v2=TreeHashFunctionImpl::compute_leaf_hash(&CompiledClassHash(hash_v2.0));
+ Ok(serde_json::to_string(&serde_json::json!({"class_hash":input.class_hash,"sierra_version":version,"compiled_hash_v1":hash_v1,"compiled_hash_v2":hash_v2,"leaf_v1":leaf_v1,"leaf_v2":leaf_v2,"casm":casm,"scope":"Sierra identity checked; pinned native compiler used locally; match compiled class leaf to authenticated classes-tree path separately"}))?)
+}
+#[wasm_bindgen::prelude::wasm_bindgen]
+pub fn compile_captured_class(bytes:&[u8])->Result<String,wasm_bindgen::JsValue>{compile_public_class(bytes).map_err(|e|wasm_bindgen::JsValue::from_str(&e.to_string()))}
