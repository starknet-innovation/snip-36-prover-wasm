+//! Sparse public-state commitment witnesses, using the pinned backend's converter and committer.
+use blockifier::state::cached_state::StateMaps;
+use starknet_api::hash::StateRoots;
+use starknet_os::commitment_infos::StateCommitmentInfos;
+use starknet_patricia::patricia_merkle_tree::node_data::inner_node::{flatten_preimages,Preimage,PreimageMap};
+use starknet_rust_core::types::StorageProof;
+use crate::pinned_committer_utils::{create_facts_db_from_storage_proof,state_maps_to_committer_state_diff,validate_virtual_os_state_diff,commit_state_diff};
+use crate::running::storage_proofs::RpcStorageProofsQuery;
+
+pub(crate) fn commit_authenticated(
+    proof:&StorageProof,query:&RpcStorageProofsQuery,initial:&StateMaps,diff:StateMaps,
+)->Result<StateCommitmentInfos,Box<dyn std::error::Error>>{
+    // Every changed path must be among the authenticated initial reads; never fill an unknown leaf with zero.
+    for address in diff.nonces.keys(){if !initial.nonces.contains_key(address){return Err("Nonce update lacks authenticated initial read".into());}}
+    for key in diff.storage.keys(){if !initial.storage.contains_key(key){return Err("Storage update lacks authenticated initial read".into());}}
+    let diff=state_maps_to_committer_state_diff(diff);validate_virtual_os_state_diff(&diff)?;
+    let mut db=create_facts_db_from_storage_proof(proof,query,initial)?;
+    let previous=StateRoots{contracts_trie_root_hash:starknet_api::hash::HashOutput(proof.global_roots.contracts_tree_root),classes_trie_root_hash:starknet_api::hash::HashOutput(proof.global_roots.classes_tree_root)};
+    let runtime=tokio::runtime::Builder::new_current_thread().build()?;
+    runtime.block_on(async{
+        let updated=commit_state_diff(&mut db,previous.contracts_trie_root_hash,previous.classes_trie_root_hash,diff).await?;
+        let mut storage=db.consume_storage();
+        let mut infos=StateCommitmentInfos::new(&previous,&updated,&mut storage,&initial.keys()).await?;
+        // Match native storage_proofs::create_commitment_infos_with_state_changes.
+        let preimages:PreimageMap=proof.classes_proof.iter().map(|(hash,node)|(starknet_api::hash::HashOutput(*hash),Preimage::from(node))).collect();
+        infos.classes_trie_commitment_info.commitment_facts.extend(flatten_preimages(&preimages));
+        Ok(infos)
+    })
+}
+
+/// Component test entry point. A proposed diff is not evidence of transaction execution.
+pub fn witness_control(proof_bytes:&[u8],classes_bytes:&[u8],diff_bytes:&[u8])->Result<String,Box<dyn std::error::Error>>{
+    let prepared:serde_json::Value=serde_json::from_str(&crate::public_state::prepare_state(proof_bytes,classes_bytes)?)?;
+    let initial:StateMaps=serde_json::from_value(prepared["initial_reads"].clone())?;
+    let input:crate::public_state::PublicProofInput=serde_json::from_slice(proof_bytes)?;
+    let diff:StateMaps=serde_json::from_slice(diff_bytes)?;
+    let infos=commit_authenticated(&input.proof,&input.query,&initial,diff)?;
+    Ok(serde_json::to_string(&serde_json::json!({"contracts":infos.contracts_trie_commitment_info,"classes":infos.classes_trie_commitment_info,"storage":infos.storage_tries_commitment_infos}))?)
+}
+#[wasm_bindgen::prelude::wasm_bindgen]
+pub fn public_witness_control(proof_bytes:&[u8],classes_bytes:&[u8],diff_bytes:&[u8])->Result<String,wasm_bindgen::JsValue>{witness_control(proof_bytes,classes_bytes,diff_bytes).map_err(|e|wasm_bindgen::JsValue::from_str(&e.to_string()))}
