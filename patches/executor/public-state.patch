+//! Fixed, deliberately public scalar-1 test signer. Never accepts private credentials.
+use starknet_types_core::felt::Felt;
+use starknet_api::transaction::InvokeTransaction;
+use crate::public_execution::ExecutionRequest;
+pub fn sign_request(bytes:&[u8])->Result<String,Box<dyn std::error::Error>>{
+ let request:ExecutionRequest=serde_json::from_slice(bytes)?;
+ let sepolia=Felt::from_hex("0x534e5f5345504f4c4941")?;
+ if request.captured_chain_id!=sepolia || Felt::from_hex(&request.chain_info.chain_id.as_hex())?!=sepolia{return Err("Public demo signer is restricted to SN_SEPOLIA".into());}
+ if !request.transaction.signature.0.is_empty(){return Err("Public demo signer requires an unsigned request".into());}
+ if !request.transaction.proof.is_empty() || !request.transaction.proof_facts.is_empty(){return Err("Public demo signer requires empty proof fields".into());}
+ let invoke=starknet_api::executable_transaction::InvokeTransaction::create(InvokeTransaction::V3(request.transaction.into()),&request.chain_info.chain_id)?;
+ let hash=invoke.tx_hash.0;
+ let signature=starknet_rust_core::crypto::ecdsa_sign(&Felt::ONE,&hash)?;
+ let public_key=Felt::from_hex("0x1ef15c18599971b7beced415a40f0c7deacfd9b0d1819e03d723d8bc943cfca")?;
+ let checked=starknet_rust_core::crypto::Signature{r:signature.r,s:signature.s};
+ if !starknet_rust_core::crypto::ecdsa_verify(&public_key,&hash,&checked)?{return Err("Public demo signature self-check failed".into());}
+ let mut signed:serde_json::Value=serde_json::from_slice(bytes)?;
+ signed["transaction"]["signature"]=serde_json::json!([signature.r,signature.s]);
+ Ok(serde_json::to_string(&serde_json::json!({"request":signed,"transaction_hash":hash,"public_key":public_key,"public_test_scalar":"0x1","scope":"Deliberately public test signer; deployment and account authorization must be authenticated separately"}))?)
+}
+#[wasm_bindgen::prelude::wasm_bindgen]
+pub fn sign_public_demo_request(bytes:&[u8])->Result<String,wasm_bindgen::JsValue>{sign_request(bytes).map_err(|e|wasm_bindgen::JsValue::from_str(&e.to_string()))}
