+//! Scoped proof-fact admission using unchanged pinned Blockifier prevalidation.
+//! Fee payment, account validation, execution and consensus inclusion are outside this check.
+use starknet_api::executable_transaction::AccountTransaction as Transaction;
+use std::collections::{HashMap,BTreeMap};
+use blockifier::{blockifier_versioned_constants::VersionedConstants,bouncer::BouncerConfig,context::BlockContext,state::cached_state::{CachedState,StateMaps},transaction::account_transaction::{AccountTransaction,ExecutionFlags}};
+use starknet_api::{core::OsChainInfo,transaction::{InvokeTransaction,fields::ProofFacts},versioned_constants_logic::VersionedConstantsTrait};
+use starknet_types_core::felt::Felt;
+use crate::public_execution::{ExecutionRequest,PublicReader};
+pub fn check(proof_bytes:&[u8],request_bytes:&[u8],facts_bytes:&[u8])->Result<String,Box<dyn std::error::Error>>{
+ let checked:serde_json::Value=serde_json::from_str(&crate::public_state::authenticate_and_convert(proof_bytes)?)?;
+ let initial:StateMaps=serde_json::from_value(checked["initial_reads"].clone())?;
+ let input:crate::public_state::PublicProofInput=serde_json::from_slice(proof_bytes)?;
+ let mut request:ExecutionRequest=serde_json::from_slice(request_bytes)?;
+ if Felt::from_hex(&request.chain_info.chain_id.as_hex())?!=request.captured_chain_id{return Err("Admission chain differs from captured chain".into());}
+ if request.chain_info.is_l3{return Err("L3 admission context unsupported".into());}
+ let facts:ProofFacts=serde_json::from_slice(facts_bytes)?;
+ if facts.0.is_empty(){return Err("Empty facts are not SNIP-36 admission evidence".into());}
+ request.transaction.proof_facts=facts;
+ let invoke=starknet_api::executable_transaction::InvokeTransaction::create(InvokeTransaction::V3(request.transaction.into()),&request.chain_info.chain_id)?;
+ let block_info=input.header.block_info()?;
+ let config=OsChainInfo::from(&request.chain_info).compute_virtual_os_config_hash(block_info.starknet_version)?;
+ let context=BlockContext::new(block_info,request.chain_info,VersionedConstants::latest_constants().clone(),BouncerConfig::default());
+ let tx=AccountTransaction{tx:Transaction::Invoke(invoke),execution_flags:ExecutionFlags{only_query:false,charge_fee:false,validate:true,strict_nonce_check:true}};
+ let mut state=CachedState::new(PublicReader{state:initial,classes:HashMap::new(),hashes_v2:BTreeMap::new()});
+ tx.perform_pre_validation_stage(&mut state,&context.to_tx_context(&tx))?;
+ Ok(serde_json::to_string(&serde_json::json!({"admission":"accepted","admission_block_hash":input.block_hash,"admission_block_number":input.header.block_number,"config_hash":config,"chain_id":request.captured_chain_id,"scope":"Unchanged pinned nonce and proof version/program/block-age/stored-block-hash/config gates against authenticated RPC state; fees and account signature validation not checked","network_acceptance_tested":false}))?)
+}
